<Window x:Class="Material3.Wpf.Gallery.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="clr-namespace:Material3.Wpf;assembly=Material3.Wpf"
        Title="Material 3 Gallery — WPF" Height="720" Width="1060" MinWidth="860" MinHeight="560"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Icon="app.ico"
        Background="{DynamicResource Surface}" UseLayoutRounding="True"
        FontFamily="{DynamicResource FontFamily}" TextOptions.TextFormattingMode="Ideal"
        TextElement.Foreground="{DynamicResource OnSurface}">
    <Window.Resources>
        <Style x:Key="GalleryNavItem" TargetType="m3:NavigationItem" BasedOn="{StaticResource NavigationDrawerItem}">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <!-- Scrollbars intentionally NOT styled here: the library's ThinThumb/ScrollBar styles come in via the
             App.xaml merge; a local copy would shadow them and the gallery would stop demoing the real thing. -->
    </Window.Resources>

    <m3:ModalLayer>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <m3:TitleBar Grid.Row="0" Title="Material 3 Gallery — WPF" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource Surface}">
                <DockPanel Margin="12,12,12,0">
                    <StackPanel DockPanel.Dock="Top">
                        <Button x:Name="ModeBtn" Style="{StaticResource TonalButton}" Height="40" Content="Light theme" m3:ButtonContent.LeadingGlyph="LightbulbOutline" Click="Mode_Click" Margin="0,0,0,8" />
                        <ComboBox x:Name="SeedCombo" Style="{StaticResource M3Combo}" Margin="0,0,0,8" SelectionChanged="Seed_Changed" />
                        <ComboBox x:Name="VariantCombo" Style="{StaticResource M3Combo}" Margin="0,0,0,12" SelectionChanged="Variant_Changed" />
                        <TextBlock Text="Seed hue — drag to recolor" Style="{StaticResource Caption}" Margin="2,0,0,6" />
                        <Slider x:Name="HueSlider" Style="{StaticResource M3Slider}" Minimum="0" Maximum="360" Value="258" ValueChanged="Hue_Changed" Margin="0,0,0,18" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,12">
                        <m3:NavigationDrawer x:Name="Nav" Width="Auto" Padding="0" Background="Transparent"
                                             ItemContainerStyle="{StaticResource GalleryNavItem}" SelectionChanged="Nav_SelectionChanged" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <ScrollViewer x:Name="Scroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0,8,8,8">
                <StackPanel x:Name="PageHost" Margin="24,8,16,24" />
            </ScrollViewer>
        </Grid>
    </Grid>
    </m3:ModalLayer>
</Window>
