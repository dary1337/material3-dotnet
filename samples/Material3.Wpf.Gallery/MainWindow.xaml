<Window x:Class="Material3.Wpf.Gallery.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:m3="clr-namespace:Material3.Wpf;assembly=Material3.Wpf"
        Title="Material 3 Gallery — WPF" Height="720" Width="1060" MinWidth="860" MinHeight="560"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Surface}" UseLayoutRounding="True"
        FontFamily="Segoe UI" TextOptions.TextFormattingMode="Ideal"
        TextElement.Foreground="{DynamicResource OnSurface}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- ===== window caption buttons ===== -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.13"><VisualTransition.GeneratedEasingFunction><StaticResource ResourceKey="M3StandardDecelerate" /></VisualTransition.GeneratedEasingFunction></VisualTransition>
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="MouseOver"><Storyboard><DoubleAnimation Storyboard.TargetName="state" Storyboard.TargetProperty="Opacity" To="0.08" Duration="0" /></Storyboard></VisualState>
                                    <VisualState x:Name="Pressed"><Storyboard><DoubleAnimation Storyboard.TargetName="state" Storyboard.TargetProperty="Opacity" To="0.12" Duration="0" /></Storyboard></VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="state" Background="{DynamicResource OnSurfaceVariant}" Opacity="0" CornerRadius="16" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.13"><VisualTransition.GeneratedEasingFunction><StaticResource ResourceKey="M3StandardDecelerate" /></VisualTransition.GeneratedEasingFunction></VisualTransition>
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="MouseOver"><Storyboard><DoubleAnimation Storyboard.TargetName="state" Storyboard.TargetProperty="Opacity" To="0.08" Duration="0" /></Storyboard></VisualState>
                                    <VisualState x:Name="Pressed"><Storyboard><DoubleAnimation Storyboard.TargetName="state" Storyboard.TargetProperty="Opacity" To="0.12" Duration="0" /></Storyboard></VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="state" Background="{DynamicResource Error}" Opacity="0" CornerRadius="16" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Error}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== nav pill (left-aligned, like the WinForms gallery rail) ===== -->
        <Style x:Key="NavPill" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="pill" Background="Transparent" CornerRadius="20">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.13"><VisualTransition.GeneratedEasingFunction><StaticResource ResourceKey="M3StandardDecelerate" /></VisualTransition.GeneratedEasingFunction></VisualTransition>
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="MouseOver"><Storyboard><DoubleAnimation Storyboard.TargetName="st" Storyboard.TargetProperty="Opacity" To="0.08" Duration="0" /></Storyboard></VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid>
                                <!-- Selection rides its own layer so it can fade in; the pill's own Background
                                     could only be swapped, and the indicator would pop between nav items. -->
                                <Border x:Name="sel" Background="{DynamicResource SecondaryContainer}" Opacity="0" CornerRadius="20" />
                                <Border x:Name="st" Background="{DynamicResource OnSurface}" Opacity="0" CornerRadius="20" />
                                <ContentPresenter VerticalAlignment="Center" Margin="16,9" TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainer}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard><DoubleAnimation Storyboard.TargetName="sel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" EasingFunction="{StaticResource M3StandardDecelerate}" /></Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard><DoubleAnimation Storyboard.TargetName="sel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" EasingFunction="{StaticResource M3StandardAccelerate}" /></Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Scrollbars intentionally NOT styled here: the library's ThinThumb/ScrollBar styles come in via the
             App.xaml merge; a local copy would shadow them and the gallery would stop demoing the real thing. -->
    </Window.Resources>

    <m3:ModalLayer>
    <Grid x:Name="RootHost">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- title bar -->
        <Grid Grid.Row="0" Background="{DynamicResource Surface}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource Primary}">
                    <m3:PathIcon Glyph="Layers" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource OnPrimary}" />
                </Border>
                <TextBlock Text="Material 3 Gallery — WPF" Foreground="{DynamicResource OnSurface}" FontSize="14" FontWeight="SemiBold"
                           Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                        UseLayoutRounding="True" SnapsToDevicePixels="True">
                <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" Margin="0,0,4,0" AutomationProperties.Name="Minimize">
                    <Rectangle Width="11" Height="1" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Button Style="{StaticResource CaptionButton}" Click="MaxRestore_Click" Margin="0,0,4,0" AutomationProperties.Name="Maximize or restore">
                    <Grid>
                        <Rectangle x:Name="MaxGlyph" Width="10" Height="10" StrokeThickness="1"
                                   Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <Grid x:Name="RestoreGlyph" Width="11" Height="11" Visibility="Collapsed">
                            <Rectangle Width="8" Height="8" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                                       Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <Rectangle Width="8" Height="8" StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                       Fill="{DynamicResource Surface}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Grid>
                    </Grid>
                </Button>
                <Button Style="{StaticResource CloseCaptionButton}" Click="Close_Click" AutomationProperties.Name="Close">
                    <Path Data="M0,0 L10,10 M0,10 L10,0" StrokeThickness="1"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- body: nav rail + content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource Surface}">
                <StackPanel Margin="12,12,12,12">
                    <!-- the library's own TonalButton (App.xaml merge) — the most-clicked control in the demo
                         should BE the control it showcases, not a local fork of its template. -->
                    <Button x:Name="ModeBtn" Style="{StaticResource TonalButton}" Height="40" Content="Light theme" Click="Mode_Click" Margin="0,0,0,8" />
                    <ComboBox x:Name="SeedCombo" Style="{StaticResource M3Combo}" Margin="0,0,0,8" SelectionChanged="Seed_Changed" />
                    <ComboBox x:Name="VariantCombo" Style="{StaticResource M3Combo}" Margin="0,0,0,12" SelectionChanged="Variant_Changed" />
                    <TextBlock Text="Seed hue — drag to recolor" Style="{StaticResource Caption}" Margin="2,0,0,6" />
                    <Slider x:Name="HueSlider" Style="{StaticResource M3Slider}" Minimum="0" Maximum="360" Value="258" ValueChanged="Hue_Changed" Margin="0,0,0,18" />
                    <StackPanel x:Name="NavHost" />
                </StackPanel>
            </Border>

            <ScrollViewer x:Name="Scroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0,8,8,8">
                <StackPanel x:Name="PageHost" Margin="24,8,16,24" />
            </ScrollViewer>
        </Grid>
    </Grid>
    </m3:ModalLayer>
</Window>
