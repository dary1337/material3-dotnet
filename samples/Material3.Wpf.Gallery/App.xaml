<Application x:Class="Material3.Wpf.Gallery.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m3="clr-namespace:Material3.Wpf;assembly=Material3.Wpf">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Controls.xaml is self-contained: it pulls in Tokens.xaml + Motion.xaml itself. -->
                <ResourceDictionary Source="pack://application:,,,/Material3.Wpf;component/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="ScrollBar" BasedOn="{StaticResource M3ScrollBar}">
                <Setter Property="m3:AutoHideScroll.Enabled" Value="True" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
