<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Material3.WinForms.Gallery</RootNamespace>
    <AssemblyName>Material3.WinForms.Gallery</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Material3.WinForms\Material3.WinForms.csproj" />
    <InternalsVisibleTo Include="Material3.WinForms.Tests" />
  </ItemGroup>

  <!-- Single-file distributable: Costura.Fody embeds Material3.WinForms into the .exe.
       .NET Framework 4.7.2 ships with Windows 10 1803+, so the result runs
       anywhere with no install and no loose DLLs. -->
  <ItemGroup>
    <PackageReference Include="Costura.Fody" Version="6.0.0" PrivateAssets="all" />
    <PackageReference Include="Fody" Version="6.9.2" PrivateAssets="all" />
  </ItemGroup>

  <!-- The library is embedded in the exe; a loose copy left next to it from an earlier build would load first. -->
  <Target Name="DropEmbeddedLibraryCopies" AfterTargets="Build">
    <Delete Files="$(OutDir)Material3.Core.dll;$(OutDir)Material3.Core.pdb;$(OutDir)Material3.WinForms.dll;$(OutDir)Material3.WinForms.pdb" />
  </Target>

  <ItemGroup>
    <Compile Include="..\Shared\GallerySpec.cs" Link="GallerySpec.cs" />
    <Compile Include="..\Shared\GalleryGlyphs.cs" Link="GalleryGlyphs.cs" />
  </ItemGroup>

</Project>
