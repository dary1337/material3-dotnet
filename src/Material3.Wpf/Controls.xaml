        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type m3:PageHeader}">
                    <DockPanel LastChildFill="True">
                        <ContentPresenter DockPanel.Dock="Right" VerticalAlignment="Center" Margin="14,0,0,0"
                                          Content="{TemplateBinding Actions}" />
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <TextBlock x:Name="overline" Text="{TemplateBinding Overline}" Style="{DynamicResource Overline}"
                                           VerticalAlignment="Center" />
                                <ContentPresenter VerticalAlignment="Center" Margin="10,0,0,0"
                                                  Content="{TemplateBinding OverlineTrailing}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{TemplateBinding Title}" Style="{DynamicResource TitleLarge}" />
                                <ContentPresenter VerticalAlignment="Center" Margin="12,0,0,0"
                                                  Content="{TemplateBinding TitleTrailing}" />
                            </StackPanel>
                            <TextBlock x:Name="desc" Text="{TemplateBinding Description}" Style="{DynamicResource BodySmall}"
                                       TextWrapping="Wrap" MaxWidth="{TemplateBinding DescriptionMaxWidth}" HorizontalAlignment="Left" Margin="0,6,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Overline" Value="">
                            <Setter TargetName="overline" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="">
