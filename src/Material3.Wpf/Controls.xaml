<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:m3="clr-namespace:Material3.Wpf">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Material3.Wpf;component/Tokens.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Material3.Wpf;component/Motion.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <m3:RoundedClipConverter x:Key="RoundedClip" />

    <Style TargetType="Button"><Setter Property="FocusVisualStyle" Value="{x:Null}" /></Style>
    <Style TargetType="ToggleButton"><Setter Property="FocusVisualStyle" Value="{x:Null}" /></Style>
    <Style TargetType="RadioButton"><Setter Property="FocusVisualStyle" Value="{x:Null}" /></Style>
    <Style TargetType="CheckBox"><Setter Property="FocusVisualStyle" Value="{x:Null}" /></Style>
    <Style TargetType="ComboBox"><Setter Property="FocusVisualStyle" Value="{x:Null}" /></Style>

    <Style x:Key="M3FocusRing">
        <Setter Property="Control.Tag" Value="{DynamicResource FocusRingRadius}" />
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{DynamicResource Primary}" BorderThickness="2"
                            CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="M3FocusRingXs" BasedOn="{StaticResource M3FocusRing}">
        <Setter Property="Control.Tag" Value="{DynamicResource RadiusXs}" />
    </Style>
    <Style x:Key="M3FocusRingLg" BasedOn="{StaticResource M3FocusRing}">
        <Setter Property="Control.Tag" Value="{DynamicResource RadiusLg}" />
    </Style>
    <Style x:Key="M3FocusRingRound" BasedOn="{StaticResource M3FocusRing}">
        <Setter Property="Control.Tag">
            <Setter.Value><CornerRadius>999</CornerRadius></Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RowIconButton" TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="m3:Metrics.CornerRadius" Value="{DynamicResource RadiusPill}" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="state" CornerRadius="{m3:FitCornerRadius}" Background="{DynamicResource OnSurface}" Opacity="0" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="state" Property="Opacity" Value="0.08" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="state" Property="Opacity" Value="0.12" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="m3:Metrics.CornerRadius" Value="{DynamicResource RadiusSm}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="{m3:FitCornerRadius}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="c" TextElement.Foreground="{DynamicResource OnSurface}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <Border x:Name="focus" CornerRadius="{m3:FitCornerRadius}" BorderThickness="2"
                                BorderBrush="{DynamicResource Primary}" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource SurfaceContainerHigh}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource SecondaryContainer}" />
                            <Setter TargetName="c" Property="TextElement.Foreground" Value="{DynamicResource OnSecondaryContainer}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="focus" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="M3Expander" TargetType="Expander">
        <Setter Property="m3:Metrics.GlyphSize" Value="20" />
        <Setter Property="m3:Metrics.GlyphMargin" Value="0,0,8,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton Cursor="Hand" HorizontalContentAlignment="Stretch"
                                      Content="{TemplateBinding Header}"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" Padding="0,2">
                                        <DockPanel LastChildFill="True">
                                            <m3:PathIcon x:Name="Chevron" Glyph="ChevronRight" DockPanel.Dock="Left"
                                                         Width="{Binding Path=(m3:Metrics.GlyphSize), RelativeSource={RelativeSource AncestorType=Expander}}"
                                                         Height="{Binding Path=(m3:Metrics.GlyphSize), RelativeSource={RelativeSource AncestorType=Expander}}"
                                                         Margin="{Binding Path=(m3:Metrics.GlyphMargin), RelativeSource={RelativeSource AncestorType=Expander}}"
                                                         VerticalAlignment="Center"
                                                         Foreground="{DynamicResource OnSurfaceVariant}" RenderTransformOrigin="0.5,0.5">
                                                <m3:PathIcon.RenderTransform>
                                                    <RotateTransform Angle="0" />
                                                </m3:PathIcon.RenderTransform>
                                            </m3:PathIcon>
                                            <ContentPresenter VerticalAlignment="Center"
                                                              TextElement.Foreground="{DynamicResource OnSurface}" />
                                        </DockPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Chevron"
                                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                            To="90" Duration="0:0:0.18" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Chevron"
                                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                            To="0" Duration="0:0:0.18" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chevron" Property="Foreground" Value="{DynamicResource OnSurface}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
        <Setter Property="CaretBrush" Value="{DynamicResource OnSurface}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceContainerHigh}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariant}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Height" Value="{DynamicResource ControlHeight}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="m3:Metrics.CornerRadius" Value="{DynamicResource RadiusXs}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{m3:FitCornerRadius}">
                        <Grid>
                            <TextBlock x:Name="ph" Margin="{TemplateBinding Padding}" Padding="2,0,0,0"
                                       Text="{Binding Path=(m3:Placeholder.Text), RelativeSource={RelativeSource TemplatedParent}}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalAlignment="Left"
                                       Foreground="{DynamicResource OnSurfaceMuted}" IsHitTestVisible="False"
                                       Visibility="Collapsed" TextTrimming="CharacterEllipsis" />
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
                        </Trigger>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="ph" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="AcceptsReturn" Value="True">
                <Setter Property="Height" Value="Auto" />
                <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="M3PillTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Height" Value="{DynamicResource ControlHeight}" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="m3:Metrics.CornerRadius" Value="{DynamicResource RadiusPill}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{m3:FitCornerRadius}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Primary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="M3Progress" TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="m3:Metrics.CornerRadius" Value="{DynamicResource RadiusXs}" />
        <Setter Property="Foreground" Value="{DynamicResource Primary}" />
        <Setter Property="Background" Value="{DynamicResource SecondaryContainer}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" />
                        <DockPanel>
                            <Border x:Name="PART_Indicator" DockPanel.Dock="Left" CornerRadius="{m3:FitCornerRadius}" Background="{TemplateBinding Foreground}" />
                            <Grid x:Name="rest" Margin="4,0,0,0">
                                <Border CornerRadius="{m3:FitCornerRadius}" Background="{TemplateBinding Background}" />
                                <Ellipse x:Name="stop" Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}}" HorizontalAlignment="Right"
                                         Fill="{TemplateBinding Foreground}" />
                            </Grid>
                        </DockPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Value" Value="0">
                            <Setter TargetName="rest" Property="Margin" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ButtonLabel" TargetType="TextBlock" />

    <Style x:Key="DialogCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceContainerHigh}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusXl}" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="Margin" Value="32" />
        <Setter Property="m3:Metrics.GlyphSize" Value="26" />
        <Setter Property="m3:Metrics.GlyphMargin" Value="0,0,12,0" />
    </Style>

    <Style x:Key="TipCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighest}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariant}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Effect" Value="{x:Null}" />
    </Style>

    <Style x:Key="RichTipCard" TargetType="Border" BasedOn="{StaticResource TipCard}">
        <Setter Property="Background" Value="{DynamicResource SurfaceContainer}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
        <Setter Property="Padding" Value="16,12,16,14" />
        <Setter Property="Effect" Value="{x:Null}" />
    </Style>

    <Style x:Key="TipText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MaxWidth" Value="320" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
    </Style>

    <Style x:Key="RichTipText" TargetType="TextBlock" BasedOn="{StaticResource TipText}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MaxWidth" Value="312" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}" />
    </Style>

    <Style x:Key="TipTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightMedium}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
    </Style>

    <!-- A contained button's state layer is its own content colour, so one template serves every fill. -->
    <ControlTemplate x:Key="ContainedButtonTemplate" TargetType="Button">
        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="{m3:FitCornerRadius}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualStateGroup.Transitions>
                        <VisualTransition GeneratedDuration="0:0:0.13">
                            <VisualTransition.GeneratedEasingFunction><StaticResource ResourceKey="M3StandardDecelerate" /></VisualTransition.GeneratedEasingFunction>
                        </VisualTransition>
                    </VisualStateGroup.Transitions>
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="MouseOver"><Storyboard><DoubleAnimation Storyboard.TargetName="state" Storyboard.TargetProperty="Opacity" To="{StaticResource StateLayerHover}" Duration="0" /></Storyboard></VisualState>
                    <VisualState x:Name="Pressed"><Storyboard><DoubleAnimation Storyboard.TargetName="state" Storyboard.TargetProperty="Opacity" To="{StaticResource StateLayerPressed}" Duration="0" /></Storyboard></VisualState>
                    <VisualState x:Name="Disabled"><Storyboard><DoubleAnimation Storyboard.TargetName="state" Storyboard.TargetProperty="Opacity" To="0" Duration="0" /></Storyboard></VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid>
                <Border x:Name="state" Background="{TemplateBinding Foreground}" Opacity="0" CornerRadius="{m3:FitCornerRadius}" />
                <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <m3:PathIcon x:Name="lead" Width="{TemplateBinding m3:Metrics.GlyphSize}" Height="{TemplateBinding m3:Metrics.GlyphSize}" Margin="{TemplateBinding m3:Metrics.GlyphMargin}" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"
                                 Glyph="{TemplateBinding m3:ButtonContent.LeadingGlyph}" />
                    <ContentPresenter x:Name="c" VerticalAlignment="Center"
                                      TextElement.Foreground="{TemplateBinding Foreground}">
                        <ContentPresenter.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource ButtonLabel}" />
                        </ContentPresenter.Resources>
                    </ContentPresenter>
                </StackPanel>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="m3:ButtonContent.LeadingGlyph" Value="{x:Null}">
                <Setter TargetName="lead" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Content" Value="{x:Null}">
                <Setter TargetName="lead" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="Content" Value="">
                <Setter TargetName="lead" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource SurfaceContainerHighest}" />
                <Setter Property="Foreground" Value="{DynamicResource OnSurfaceMuted}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <!-- The inverted pairs put light content on a dark fill; their layer needs more to show. -->
    <ControlTemplate x:Key="InvertedButtonTemplate" TargetType="Button">
        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="{m3:FitCornerRadius}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualStateGroup.Transitions>
                        <VisualTransition GeneratedDuration="0:0:0.13">
                            <VisualTransition.GeneratedEasingFunction><StaticResource ResourceKey="M3StandardDecelerate" /></VisualTransition.GeneratedEasingFunction>
                        </VisualTransition>
                    </VisualStateGroup.Transitions>
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="MouseOver"><Storyboard><DoubleAnimation Storyboard.TargetName="state" Storyboard.TargetProperty="Opacity" To="{StaticResource StateLayerInvertedHover}" Duration="0" /></Storyboard></VisualState>
                    <VisualState x:Name="Pressed"><Storyboard><DoubleAnimation Storyboard.TargetName="state" Storyboard.TargetProperty="Opacity" To="{StaticResource StateLayerInvertedPressed}" Duration="0" /></Storyboard></VisualState>
                    <VisualState x:Name="Disabled"><Storyboard><DoubleAnimation Storyboard.TargetName="state" Storyboard.TargetProperty="Opacity" To="0" Duration="0" /></Storyboard></VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid>
                <Border x:Name="state" Background="{TemplateBinding Foreground}" Opacity="0" CornerRadius="{m3:FitCornerRadius}" />
                <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <m3:PathIcon x:Name="lead" Width="{TemplateBinding m3:Metrics.GlyphSize}" Height="{TemplateBinding m3:Metrics.GlyphSize}" Margin="{TemplateBinding m3:Metrics.GlyphMargin}" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"
                                 Glyph="{TemplateBinding m3:ButtonContent.LeadingGlyph}" />
                    <ContentPresenter x:Name="c" VerticalAlignment="Center"
                                      TextElement.Foreground="{TemplateBinding Foreground}">
                        <ContentPresenter.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource ButtonLabel}" />
                        </ContentPresenter.Resources>
                    </ContentPresenter>
                </StackPanel>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="m3:ButtonContent.LeadingGlyph" Value="{x:Null}">
                <Setter TargetName="lead" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Content" Value="{x:Null}">
                <Setter TargetName="lead" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="Content" Value="">
                <Setter TargetName="lead" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource SurfaceContainerHighest}" />
                <Setter Property="Foreground" Value="{DynamicResource OnSurfaceMuted}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="ContainedButtonBase" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource M3FocusRingRound}" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="0" />
        <Setter Property="ToolTipService.Placement" Value="Top" />
        <Setter Property="ToolTipService.ShowDuration" Value="60000" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightMedium}" />
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="m3:Metrics.CornerRadius" Value="{DynamicResource RadiusPill}" />
        <Setter Property="m3:Metrics.GlyphSize" Value="18" />
        <Setter Property="m3:Metrics.GlyphMargin" Value="-8,0,8,0" />
        <Setter Property="Template" Value="{StaticResource ContainedButtonTemplate}" />
    </Style>

    <Style x:Key="TonalButton" TargetType="Button" BasedOn="{StaticResource ContainedButtonBase}">
        <Setter Property="Background" Value="{DynamicResource SecondaryContainer}" />
        <Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainer}" />
    </Style>

    <!-- The shadow sits on a layer of its own: an Effect on the content's border would rasterize the label. -->
    <Style x:Key="ElevatedButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource M3FocusRingRound}" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="0" />
        <Setter Property="ToolTipService.Placement" Value="Top" />
        <Setter Property="ToolTipService.ShowDuration" Value="60000" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightMedium}" />
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="m3:Metrics.CornerRadius" Value="{DynamicResource RadiusPill}" />
        <Setter Property="m3:Metrics.GlyphSize" Value="18" />
        <Setter Property="m3:Metrics.GlyphMargin" Value="-8,0,8,0" />
        <Setter Property="Foreground" Value="{DynamicResource Primary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="shadow" Background="{DynamicResource SurfaceContainerLow}" CornerRadius="{m3:FitCornerRadius}"
                                Effect="{StaticResource Elevation1}" />
                        <Border x:Name="b" Background="{DynamicResource SurfaceContainerLow}" CornerRadius="{m3:FitCornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.13">
                                            <VisualTransition.GeneratedEasingFunction><StaticResource ResourceKey="M3StandardDecelerate" /></VisualTransition.GeneratedEasingFunction>
                                        </VisualTransition>
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="MouseOver"><Storyboard><DoubleAnimation Storyboard.TargetName="state" Storyboard.TargetProperty="Opacity" To="{StaticResource StateLayerHover}" Duration="0" /></Storyboard></VisualState>
                                    <VisualState x:Name="Pressed"><Storyboard><DoubleAnimation Storyboard.TargetName="state" Storyboard.TargetProperty="Opacity" To="{StaticResource StateLayerPressed}" Duration="0" /></Storyboard></VisualState>
                                    <VisualState x:Name="Disabled"><Storyboard><DoubleAnimation Storyboard.TargetName="state" Storyboard.TargetProperty="Opacity" To="0" Duration="0" /></Storyboard></VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid>
                                <Border x:Name="state" Background="{DynamicResource Primary}" Opacity="0" CornerRadius="{m3:FitCornerRadius}" />
                                <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <m3:PathIcon x:Name="lead" Width="{TemplateBinding m3:Metrics.GlyphSize}" Height="{TemplateBinding m3:Metrics.GlyphSize}" Margin="{TemplateBinding m3:Metrics.GlyphMargin}" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"
                                                 Glyph="{TemplateBinding m3:ButtonContent.LeadingGlyph}" />
                                    <ContentPresenter x:Name="c" VerticalAlignment="Center"
                                                      TextElement.Foreground="{TemplateBinding Foreground}">
                                        <ContentPresenter.Resources>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource ButtonLabel}" />
                                        </ContentPresenter.Resources>
                                    </ContentPresenter>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="m3:ButtonContent.LeadingGlyph" Value="{x:Null}">
                            <Setter TargetName="lead" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="lead" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="Content" Value="">
                            <Setter TargetName="lead" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource SurfaceContainerHighest}" />
                            <Setter TargetName="shadow" Property="Visibility" Value="Collapsed" />
                            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceMuted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FilledButton" TargetType="Button" BasedOn="{StaticResource ContainedButtonBase}">
        <Setter Property="Background" Value="{DynamicResource Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource OnPrimary}" />
    </Style>

    <Style x:Key="ShinyButton" TargetType="Button" BasedOn="{StaticResource FilledButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="{m3:FitCornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.13">
                                        <VisualTransition.GeneratedEasingFunction><StaticResource ResourceKey="M3StandardDecelerate" /></VisualTransition.GeneratedEasingFunction>
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="MouseOver"><Storyboard><DoubleAnimation Storyboard.TargetName="state" Storyboard.TargetProperty="Opacity" To="{StaticResource StateLayerHover}" Duration="0" /></Storyboard></VisualState>
                                <VisualState x:Name="Pressed"><Storyboard><DoubleAnimation Storyboard.TargetName="state" Storyboard.TargetProperty="Opacity" To="{StaticResource StateLayerPressed}" Duration="0" /></Storyboard></VisualState>
                                <VisualState x:Name="Disabled"><Storyboard><DoubleAnimation Storyboard.TargetName="state" Storyboard.TargetProperty="Opacity" To="0" Duration="0" /></Storyboard></VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid>
                            <Grid.Clip>
                                <MultiBinding Converter="{StaticResource RoundedClip}">
                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                                    <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                                    <Binding Path="(m3:Metrics.CornerRadius)" RelativeSource="{RelativeSource TemplatedParent}" />
                                </MultiBinding>
                            </Grid.Clip>
                            <Border x:Name="state" Background="{TemplateBinding Foreground}" Opacity="0" CornerRadius="{m3:FitCornerRadius}" />
                            <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <m3:PathIcon x:Name="lead" Width="{TemplateBinding m3:Metrics.GlyphSize}" Height="{TemplateBinding m3:Metrics.GlyphSize}" Margin="{TemplateBinding m3:Metrics.GlyphMargin}" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"
                                             Glyph="{TemplateBinding m3:ButtonContent.LeadingGlyph}" />
                                <ContentPresenter x:Name="c" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource ButtonLabel}" />
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </StackPanel>
                            <Border x:Name="shine" Width="32" HorizontalAlignment="Left" IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00FFFFFF" Offset="0" />
                                        <GradientStop Color="#B3FFFFFF" Offset="0.5" />
                                        <GradientStop Color="#00FFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.RenderTransform>
                                    <TransformGroup>
                                        <SkewTransform AngleX="-18" />
                                        <TranslateTransform x:Name="shineT" X="-60" />
                                    </TransformGroup>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="m3:ButtonContent.LeadingGlyph" Value="{x:Null}">
                            <Setter TargetName="lead" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="lead" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="Content" Value="">
                            <Setter TargetName="lead" Property="Margin" Value="0" />
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=True}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Name="shineSb">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="shineT" Storyboard.TargetProperty="X">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="-60" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.0" Value="240" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:3.6" Value="240" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="shineSb" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource SurfaceContainerHighest}" />
                            <Setter TargetName="shine" Property="Opacity" Value="0" />
                            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceMuted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

