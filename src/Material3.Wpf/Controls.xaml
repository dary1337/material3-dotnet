        <Setter Property="Padding" Value="6,2" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="m3:Metrics.CornerRadius" Value="5" />
        <Setter Property="m3:Metrics.GlyphSize" Value="14" />
        <Setter Property="m3:Metrics.GlyphMargin" Value="0,0,4,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type m3:Chip}">
                    <Border x:Name="bg" CornerRadius="{m3:FitCornerRadius}" Padding="{TemplateBinding Padding}"
                            Background="{DynamicResource SurfaceContainerHighest}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <m3:PathIcon x:Name="ic" Grid.Column="0" Glyph="{TemplateBinding Glyph}" Width="{TemplateBinding m3:Metrics.GlyphSize}"
                                         Height="{TemplateBinding m3:Metrics.GlyphSize}" VerticalAlignment="Center" Margin="{TemplateBinding m3:Metrics.GlyphMargin}"
                                         Foreground="{DynamicResource OnSurfaceVariant}" />
                            <TextBlock x:Name="tx" Grid.Column="1" Text="{TemplateBinding Text}" FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" Foreground="{DynamicResource OnSurfaceVariant}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Glyph" Value="{x:Null}">
                            <Setter TargetName="ic" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Tone" Value="Success">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource SuccessContainer}" />
                            <Setter TargetName="ic" Property="Foreground" Value="{DynamicResource OnSuccessContainer}" />
                            <Setter TargetName="tx" Property="Foreground" Value="{DynamicResource OnSuccessContainer}" />
                        </Trigger>
                        <Trigger Property="Tone" Value="Accent">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource SecondaryContainer}" />
                            <Setter TargetName="ic" Property="Foreground" Value="{DynamicResource OnSecondaryContainer}" />
                            <Setter TargetName="tx" Property="Foreground" Value="{DynamicResource OnSecondaryContainer}" />
                        </Trigger>
                        <Trigger Property="Tone" Value="Warning">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource WarningContainer}" />
                            <Setter TargetName="ic" Property="Foreground" Value="{DynamicResource OnWarningContainer}" />
                            <Setter TargetName="tx" Property="Foreground" Value="{DynamicResource OnWarningContainer}" />
                        </Trigger>
                        <Trigger Property="Tone" Value="Error">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource ErrorContainer}" />
                            <Setter TargetName="ic" Property="Foreground" Value="{DynamicResource OnErrorContainer}" />
                            <Setter TargetName="tx" Property="Foreground" Value="{DynamicResource OnErrorContainer}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Size" Value="Large"><Setter Property="FontSize" Value="12" /><Setter Property="Padding" Value="8,2,8,3" /><Setter Property="m3:Metrics.CornerRadius" Value="10" /></Trigger>
            <Trigger Property="Kind" Value="Assist"><Setter Property="Template" Value="{StaticResource Interactive}" /><Setter Property="Focusable" Value="True" /><Setter Property="IsTabStop" Value="True" /><Setter Property="Cursor" Value="Hand" /><Setter Property="Height" Value="32" /><Setter Property="FontSize" Value="14" /><Setter Property="Padding" Value="16,0" /><Setter Property="m3:Metrics.CornerRadius" Value="{DynamicResource RadiusSm}" /><Setter Property="m3:Metrics.GlyphSize" Value="18" /><Setter Property="m3:Metrics.GlyphMargin" Value="-8,0,8,0" /></Trigger>
            <Trigger Property="Kind" Value="Filter"><Setter Property="Template" Value="{StaticResource Interactive}" /><Setter Property="Focusable" Value="True" /><Setter Property="IsTabStop" Value="True" /><Setter Property="Cursor" Value="Hand" /><Setter Property="Height" Value="32" /><Setter Property="FontSize" Value="14" /><Setter Property="Padding" Value="16,0" /><Setter Property="m3:Metrics.CornerRadius" Value="{DynamicResource RadiusSm}" /><Setter Property="m3:Metrics.GlyphSize" Value="18" /><Setter Property="m3:Metrics.GlyphMargin" Value="-8,0,8,0" /></Trigger>
            <Trigger Property="Kind" Value="Input"><Setter Property="Template" Value="{StaticResource Interactive}" /><Setter Property="Focusable" Value="True" /><Setter Property="IsTabStop" Value="True" /><Setter Property="Cursor" Value="Hand" /><Setter Property="Height" Value="32" /><Setter Property="FontSize" Value="14" /><Setter Property="Padding" Value="16,0" /><Setter Property="m3:Metrics.CornerRadius" Value="{DynamicResource RadiusSm}" /><Setter Property="m3:Metrics.GlyphSize" Value="18" /><Setter Property="m3:Metrics.GlyphMargin" Value="-8,0,8,0" /></Trigger>
            <Trigger Property="Kind" Value="Suggestion"><Setter Property="Template" Value="{StaticResource Interactive}" /><Setter Property="Focusable" Value="True" /><Setter Property="IsTabStop" Value="True" /><Setter Property="Cursor" Value="Hand" /><Setter Property="Height" Value="32" /><Setter Property="FontSize" Value="14" /><Setter Property="Padding" Value="16,0" /><Setter Property="m3:Metrics.CornerRadius" Value="{DynamicResource RadiusSm}" /><Setter Property="m3:Metrics.GlyphSize" Value="18" /><Setter Property="m3:Metrics.GlyphMargin" Value="-8,0,8,0" /></Trigger>
        </Style.Triggers>
    </Style>

