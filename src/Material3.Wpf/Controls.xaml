        <Setter Property="ToolTipService.ShowDuration" Value="60000" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Foreground" Value="{DynamicResource Primary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent" CornerRadius="20" Padding="14,0">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.13">
                                        <VisualTransition.GeneratedEasingFunction><StaticResource ResourceKey="M3StandardDecelerate" /></VisualTransition.GeneratedEasingFunction>
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="MouseOver"><Storyboard><DoubleAnimation Storyboard.TargetName="state" Storyboard.TargetProperty="Opacity" To="0.08" Duration="0" /></Storyboard></VisualState>
                                <VisualState x:Name="Pressed"><Storyboard><DoubleAnimation Storyboard.TargetName="state" Storyboard.TargetProperty="Opacity" To="0.12" Duration="0" /></Storyboard></VisualState>
                                <VisualState x:Name="Disabled"><Storyboard><DoubleAnimation Storyboard.TargetName="state" Storyboard.TargetProperty="Opacity" To="0" Duration="0" /></Storyboard></VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid>
                            <Border x:Name="state" Background="{DynamicResource Primary}" Opacity="0" CornerRadius="20" Margin="-14,0" />
                            <ContentPresenter x:Name="c" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource ButtonLabel}" />
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceMuted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OutlinedButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="0" />
        <Setter Property="ToolTipService.Placement" Value="Top" />
        <Setter Property="ToolTipService.ShowDuration" Value="60000" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Foreground" Value="{DynamicResource Primary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent" BorderBrush="{DynamicResource Outline}"
                            BorderThickness="1" CornerRadius="20">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.13">
                                        <VisualTransition.GeneratedEasingFunction><StaticResource ResourceKey="M3StandardDecelerate" /></VisualTransition.GeneratedEasingFunction>
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="MouseOver"><Storyboard><DoubleAnimation Storyboard.TargetName="state" Storyboard.TargetProperty="Opacity" To="0.08" Duration="0" /></Storyboard></VisualState>
                                <VisualState x:Name="Pressed"><Storyboard><DoubleAnimation Storyboard.TargetName="state" Storyboard.TargetProperty="Opacity" To="0.12" Duration="0" /></Storyboard></VisualState>
                                <VisualState x:Name="Disabled"><Storyboard><DoubleAnimation Storyboard.TargetName="state" Storyboard.TargetProperty="Opacity" To="0" Duration="0" /></Storyboard></VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid>
                            <Border x:Name="state" Background="{DynamicResource Primary}" Opacity="0" CornerRadius="20" />
                            <ContentPresenter x:Name="c" Margin="17,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource ButtonLabel}" />
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource OutlineVariant}" />
                            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceMuted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border x:Name="surface" Background="{DynamicResource SurfaceContainerHigh}" BorderBrush="{DynamicResource OutlineVariant}"
                            BorderThickness="1" CornerRadius="10" Padding="5">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="ContextMenu.Opened">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="surface" Storyboard.TargetProperty="Opacity"
                                                     From="0" To="1" Duration="0:0:0.11"
                                                     EasingFunction="{StaticResource M3StandardDecelerate}" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="b" Background="Transparent" CornerRadius="7" Padding="10,7" Margin="0,1" MinWidth="180">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <m3:PathIcon x:Name="check" Grid.Column="0" Glyph="Check" Width="16" Height="16"
                                         VerticalAlignment="Center" Foreground="{DynamicResource Primary}" Visibility="Collapsed" />
                            <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"
                                              TextElement.Foreground="{DynamicResource OnSurface}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource SurfaceContainerHighest}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{DynamicResource OutlineVariant}" Opacity="1.0" Margin="8,4" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThinThumb" TargetType="Thumb">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="t" CornerRadius="4" Background="{DynamicResource OnSurfaceVariant}" Opacity="0.42" Margin="4,2" />
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="True">
                            <Setter TargetName="t" Property="Margin" Value="2,2" />
                            <Setter TargetName="t" Property="Opacity" Value="0.85" />
                        </DataTrigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="t" Property="Margin" Value="2,2" />
                            <Setter TargetName="t" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="M3ScrollBar" TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ThinThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ThinThumb}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ScrollBar" BasedOn="{StaticResource M3ScrollBar}" />

    <Style TargetType="ToolTip">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Margin="10" Background="{DynamicResource SurfaceContainerHighest}" BorderBrush="{DynamicResource OutlineVariant}"
                            BorderThickness="1" CornerRadius="8" Padding="10,7" MaxWidth="320"
                            SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.55" /></Border.Effect>
                        <ContentPresenter TextElement.Foreground="{DynamicResource OnSurface}">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="Segoe UI" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type m3:Chip}">
        <Style.Resources>
            <ControlTemplate x:Key="Interactive" TargetType="{x:Type m3:Chip}">
                <Border x:Name="bg" Height="32" CornerRadius="{StaticResource RadiusSm}" Background="Transparent"
                        BorderBrush="{DynamicResource OutlineVariant}" BorderThickness="1">
                    <Grid>
                        <Border x:Name="st" CornerRadius="{StaticResource RadiusSm}" Background="{DynamicResource OnSurfaceVariant}" Opacity="0" Margin="-1" />
                        <StackPanel x:Name="row" Orientation="Horizontal" Margin="16,0">
                            <m3:PathIcon x:Name="PART_Leading" Glyph="{TemplateBinding Glyph}" Width="18" Height="18" Margin="-8,0,8,0"
                                         VerticalAlignment="Center" Foreground="{DynamicResource Primary}" />
                            <TextBlock x:Name="tx" Text="{TemplateBinding Text}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource OnSurfaceVariant}" />
                            <Button x:Name="PART_Remove" Style="{StaticResource RowIconButton}" Width="24" Height="24" Margin="4,0,-10,0"
                                    Visibility="Collapsed">
                                <m3:PathIcon Glyph="Close" Width="16" Height="16" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="Glyph" Value="{x:Null}">
                        <Setter TargetName="PART_Leading" Property="Visibility" Value="Collapsed" />
                    </Trigger>
                    <Trigger Property="Kind" Value="Filter">
                        <Setter TargetName="PART_Leading" Property="Visibility" Value="Visible" />
                    </Trigger>
                    <Trigger Property="Kind" Value="Input">
                        <Setter TargetName="PART_Remove" Property="Visibility" Value="Visible" />
                        <Setter TargetName="PART_Leading" Property="Foreground" Value="{DynamicResource OnSurfaceVariant}" />
                    </Trigger>
                    <Trigger Property="Kind" Value="Filter">
                        <Setter TargetName="PART_Leading" Property="Foreground" Value="{DynamicResource OnSurfaceVariant}" />
                    </Trigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="Kind" Value="Filter" />
                            <Condition Property="IsSelected" Value="True" />
                        </MultiTrigger.Conditions>
                        <Setter TargetName="bg" Property="Background" Value="{DynamicResource SecondaryContainer}" />
                        <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource SecondaryContainer}" />
                        <Setter TargetName="PART_Leading" Property="Glyph" Value="Check" />
                        <Setter TargetName="PART_Leading" Property="Visibility" Value="Visible" />
                        <Setter TargetName="PART_Leading" Property="Foreground" Value="{DynamicResource OnSecondaryContainer}" />
                        <Setter TargetName="tx" Property="Foreground" Value="{DynamicResource OnSecondaryContainer}" />
                        <Setter TargetName="st" Property="Background" Value="{DynamicResource OnSecondaryContainer}" />
                    </MultiTrigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="st" Property="Opacity" Value="0.08" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="st" Property="Opacity" Value="0.12" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.38" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Style.Resources>
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource M3FocusRing}" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="0" />
        <Setter Property="ToolTipService.Placement" Value="Top" />
        <Setter Property="ToolTipService.ShowDuration" Value="60000" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type m3:Chip}">
                    <Border x:Name="bg" CornerRadius="5" Padding="6,2" Background="{DynamicResource SurfaceContainerHighest}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <m3:PathIcon x:Name="ic" Grid.Column="0" Glyph="{TemplateBinding Glyph}" Width="14" Height="14"
                                         VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource OnSurfaceVariant}" />
                            <TextBlock x:Name="tx" Grid.Column="1" Text="{TemplateBinding Text}" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" Foreground="{DynamicResource OnSurfaceVariant}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Glyph" Value="{x:Null}">
                            <Setter TargetName="ic" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Size" Value="Large">
                            <Setter TargetName="bg" Property="CornerRadius" Value="10" />
                            <Setter TargetName="bg" Property="Padding" Value="8,2,8,3" />
                            <Setter TargetName="tx" Property="FontSize" Value="12" />
                        </Trigger>
                        <Trigger Property="Tone" Value="Success">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource SuccessContainer}" />
                            <Setter TargetName="ic" Property="Foreground" Value="{DynamicResource OnSuccessContainer}" />
                            <Setter TargetName="tx" Property="Foreground" Value="{DynamicResource OnSuccessContainer}" />
                        </Trigger>
                        <Trigger Property="Tone" Value="Accent">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource SecondaryContainer}" />
                            <Setter TargetName="ic" Property="Foreground" Value="{DynamicResource OnSecondaryContainer}" />
                            <Setter TargetName="tx" Property="Foreground" Value="{DynamicResource OnSecondaryContainer}" />
                        </Trigger>
                        <Trigger Property="Tone" Value="Warning">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource WarningContainer}" />
                            <Setter TargetName="ic" Property="Foreground" Value="{DynamicResource OnWarningContainer}" />
                            <Setter TargetName="tx" Property="Foreground" Value="{DynamicResource OnWarningContainer}" />
                        </Trigger>
                        <Trigger Property="Tone" Value="Error">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource ErrorContainer}" />
                            <Setter TargetName="ic" Property="Foreground" Value="{DynamicResource OnErrorContainer}" />
                            <Setter TargetName="tx" Property="Foreground" Value="{DynamicResource OnErrorContainer}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Kind" Value="Assist"><Setter Property="Template" Value="{StaticResource Interactive}" /><Setter Property="Focusable" Value="True" /><Setter Property="IsTabStop" Value="True" /><Setter Property="Cursor" Value="Hand" /></Trigger>
            <Trigger Property="Kind" Value="Filter"><Setter Property="Template" Value="{StaticResource Interactive}" /><Setter Property="Focusable" Value="True" /><Setter Property="IsTabStop" Value="True" /><Setter Property="Cursor" Value="Hand" /></Trigger>
            <Trigger Property="Kind" Value="Input"><Setter Property="Template" Value="{StaticResource Interactive}" /><Setter Property="Focusable" Value="True" /><Setter Property="IsTabStop" Value="True" /><Setter Property="Cursor" Value="Hand" /></Trigger>
            <Trigger Property="Kind" Value="Suggestion"><Setter Property="Template" Value="{StaticResource Interactive}" /><Setter Property="Focusable" Value="True" /><Setter Property="IsTabStop" Value="True" /><Setter Property="Cursor" Value="Hand" /></Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceContainer}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="MenuItemButton" TargetType="Button">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent" CornerRadius="{StaticResource RadiusSm}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.13"><VisualTransition.GeneratedEasingFunction><StaticResource ResourceKey="M3StandardDecelerate" /></VisualTransition.GeneratedEasingFunction></VisualTransition>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="MouseOver"><Storyboard><DoubleAnimation Storyboard.TargetName="state" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /></Storyboard></VisualState>
                                <VisualState x:Name="Pressed"><Storyboard><DoubleAnimation Storyboard.TargetName="state" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /></Storyboard></VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid>
                            <Border x:Name="state" Background="{DynamicResource SurfaceContainerHighest}" CornerRadius="{StaticResource RadiusSm}" Opacity="0" />
                            <ContentPresenter VerticalAlignment="Center" Margin="11,8" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconButtonBase" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="0" />
        <Setter Property="ToolTipService.Placement" Value="Top" />
        <Setter Property="ToolTipService.ShowDuration" Value="60000" />
    </Style>

    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource IconButtonBase}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent" CornerRadius="{StaticResource RadiusMd}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource SurfaceContainerHighest}" />
                            <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconToggle" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Width="32" Height="32" CornerRadius="{StaticResource RadiusMd}" Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.13"><VisualTransition.GeneratedEasingFunction><StaticResource ResourceKey="M3StandardDecelerate" /></VisualTransition.GeneratedEasingFunction></VisualTransition>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="MouseOver"><Storyboard><DoubleAnimation Storyboard.TargetName="state" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /></Storyboard></VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid>
                            <Border x:Name="state" Background="{DynamicResource SurfaceContainerHighest}" CornerRadius="{StaticResource RadiusMd}" Opacity="0" />
                            <m3:PathIcon x:Name="icon" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource OnSurfaceVariant}">
                                <m3:PathIcon.Glyph>
                                    <MultiBinding>
                                        <MultiBinding.Converter><m3:IconToggleGlyphConverter /></MultiBinding.Converter>
                                        <Binding Path="IsChecked" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="(m3:IconToggle.Glyph)" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="(m3:IconToggle.CheckedGlyph)" RelativeSource="{RelativeSource TemplatedParent}" />
                                    </MultiBinding>
                                </m3:PathIcon.Glyph>
                            </m3:PathIcon>
                            <m3:PathIcon x:Name="spin" Glyph="Loading" Width="20" Height="20" Visibility="Collapsed"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Primary}"
                                       m3:Busy.SpinWhileVisible="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="m3:IconToggle.CheckedGlyph" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="icon" Property="Foreground" Value="{DynamicResource Primary}" />
                            <Setter TargetName="state" Property="Opacity" Value="1" />
                        </MultiTrigger>
                        <Trigger Property="m3:Busy.IsBusy" Value="True">
                            <Setter TargetName="icon" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="spin" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="icon" Property="Foreground" Value="{DynamicResource OnSurfaceMuted}" />
                            <Setter Property="Opacity" Value="0.38" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="M3Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <DockPanel Background="Transparent" LastChildFill="True">
                        <Grid Width="46" Height="28" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="14,0,0,0">
                            <Border x:Name="trackOff" CornerRadius="14" BorderThickness="2"
                                    BorderBrush="{DynamicResource OnSurfaceVariant}" Background="{DynamicResource SurfaceContainerHighest}" />
                            <Border x:Name="trackOn" CornerRadius="14" Background="{DynamicResource Primary}" Opacity="0" />
                            <Grid x:Name="thumbGroup" Width="28" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Grid.RenderTransform><TranslateTransform x:Name="slide" /></Grid.RenderTransform>
                                <Ellipse x:Name="state" Width="28" Height="28" Fill="{DynamicResource OnSurface}" Opacity="0" />
                                <Ellipse x:Name="thumbOff" Width="16" Height="16" Fill="{DynamicResource OnSurfaceVariant}" />
                                <Ellipse x:Name="thumbOn" Width="20" Height="20" Fill="{DynamicResource OnPrimary}" Opacity="0" />
                            </Grid>
                        </Grid>
                        <ContentPresenter VerticalAlignment="Center" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="slide" Storyboard.TargetProperty="X" To="18" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="trackOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="thumbOff" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="thumbOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="slide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="trackOn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="thumbOff" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="thumbOn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="state" Storyboard.TargetProperty="Opacity" To="0.10" Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="state" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="M3Radio" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="20" Height="20" VerticalAlignment="Center">
                            <Ellipse x:Name="ring" Width="20" Height="20" StrokeThickness="2"
                                     Stroke="{DynamicResource OnSurfaceVariant}" Fill="Transparent" />
                            <Ellipse x:Name="dot" Width="10" Height="10" Fill="{DynamicResource Primary}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><ScaleTransform x:Name="dotScale" ScaleX="0" ScaleY="0" /></Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ContentPresenter x:Name="label" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource Primary}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="dotScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="dotScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="dotScale" Storyboard.TargetProperty="ScaleX" To="0" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="dotScale" Storyboard.TargetProperty="ScaleY" To="0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="label" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type m3:Skeleton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type m3:Skeleton}">
                    <Border Background="{DynamicResource SurfaceContainerHigh}" CornerRadius="{TemplateBinding CornerRadius}">
                        <Border x:Name="PART_Shimmer" CornerRadius="{TemplateBinding CornerRadius}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type m3:PopupCard}">
        <Setter Property="Padding" Value="5" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type m3:PopupCard}">
                    <Grid>
                        <Border Background="{DynamicResource SurfaceContainerHigh}" BorderBrush="{DynamicResource OutlineVariant}"
                                BorderThickness="1" CornerRadius="{StaticResource RadiusMd}">
                            <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.45" /></Border.Effect>
                        </Border>
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type m3:PageHeader}">
        <Setter Property="Margin" Value="0,0,0,14" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type m3:PageHeader}">
                    <DockPanel LastChildFill="True">
                        <ContentPresenter DockPanel.Dock="Right" VerticalAlignment="Center" Margin="14,0,0,0"
                                          Content="{TemplateBinding Actions}" />
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <TextBlock x:Name="overline" Text="{TemplateBinding Overline}" Style="{StaticResource Overline}"
                                           VerticalAlignment="Center" />
                                <ContentPresenter VerticalAlignment="Center" Margin="10,0,0,0"
                                                  Content="{TemplateBinding OverlineTrailing}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{TemplateBinding Title}" Style="{StaticResource TitleLarge}" />
                                <ContentPresenter VerticalAlignment="Center" Margin="12,0,0,0"
                                                  Content="{TemplateBinding TitleTrailing}" />
                            </StackPanel>
                            <TextBlock x:Name="desc" Text="{TemplateBinding Description}" Style="{StaticResource BodySmall}"
                                       TextWrapping="Wrap" MaxWidth="680" HorizontalAlignment="Left" Margin="0,6,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Overline" Value="">
                            <Setter TargetName="overline" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="">
                            <Setter TargetName="desc" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type m3:NoticeBanner}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type m3:NoticeBanner}">
                    <Border x:Name="root" CornerRadius="{StaticResource RadiusMd}" Padding="12,8" BorderThickness="0"
                            Background="{DynamicResource WarningContainer}">
                        <DockPanel>
                            <Button x:Name="PART_Dismiss" DockPanel.Dock="Right"
                                    VerticalAlignment="Center" Margin="6,0,0,0"
                                    Foreground="{DynamicResource OnWarningContainer}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid Width="24" Height="24" Background="Transparent">
                                            <Border x:Name="layer" CornerRadius="12" Opacity="0"
                                                    Background="{TemplateBinding Foreground}" />
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="layer" Property="Opacity" Value="0.12" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="True">
                                                <Setter Property="Cursor" Value="Hand" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.38" />
                                                <Setter Property="Cursor" Value="Arrow" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <m3:PathIcon x:Name="dismissIcon" Glyph="Close" Width="16" Height="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <ContentPresenter DockPanel.Dock="Right" VerticalAlignment="Center"
                                              Content="{TemplateBinding Actions}" />
                            <m3:PathIcon x:Name="icon" Glyph="{TemplateBinding Glyph}" Width="16" Height="16"
                                       VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{DynamicResource OnWarningContainer}" />
                            <TextBlock x:Name="body" Text="{TemplateBinding Text}" Style="{StaticResource BodyDense}"
                                       VerticalAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{DynamicResource OnWarningContainer}" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tone" Value="Neutral">
                            <Setter TargetName="root" Property="Background" Value="{DynamicResource SurfaceContainerHigh}" />
                            <Setter TargetName="root" Property="BorderThickness" Value="1" />
                            <Setter TargetName="root" Property="BorderBrush" Value="{DynamicResource OutlineVariant}" />
                            <Setter TargetName="body" Property="Foreground" Value="{DynamicResource OnSurface}" />
                            <Setter TargetName="icon" Property="Foreground" Value="{DynamicResource Primary}" />
                            <Setter TargetName="PART_Dismiss" Property="Foreground" Value="{DynamicResource OnSurfaceMuted}" />
                        </Trigger>
                        <Trigger Property="Tone" Value="Accent">
                            <Setter TargetName="root" Property="Background" Value="{DynamicResource SecondaryContainer}" />
                            <Setter TargetName="body" Property="Foreground" Value="{DynamicResource OnSecondaryContainer}" />
                            <Setter TargetName="icon" Property="Foreground" Value="{DynamicResource OnSecondaryContainer}" />
                            <Setter TargetName="PART_Dismiss" Property="Foreground" Value="{DynamicResource OnSecondaryContainer}" />
                        </Trigger>
                        <Trigger Property="Tone" Value="Success">
                            <Setter TargetName="root" Property="Background" Value="{DynamicResource SuccessContainer}" />
                            <Setter TargetName="body" Property="Foreground" Value="{DynamicResource OnSuccessContainer}" />
                            <Setter TargetName="icon" Property="Foreground" Value="{DynamicResource OnSuccessContainer}" />
                            <Setter TargetName="PART_Dismiss" Property="Foreground" Value="{DynamicResource OnSuccessContainer}" />
                        </Trigger>
                        <Trigger Property="Tone" Value="Error">
                            <Setter TargetName="root" Property="Background" Value="{DynamicResource ErrorContainer}" />
                            <Setter TargetName="body" Property="Foreground" Value="{DynamicResource OnErrorContainer}" />
                            <Setter TargetName="icon" Property="Foreground" Value="{DynamicResource OnErrorContainer}" />
                            <Setter TargetName="PART_Dismiss" Property="Foreground" Value="{DynamicResource OnErrorContainer}" />
                        </Trigger>
                        <Trigger Property="CanDismiss" Value="False">
                            <Setter TargetName="PART_Dismiss" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type m3:EmptyState}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type m3:EmptyState}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <m3:PathIcon Glyph="{TemplateBinding Glyph}" Width="44" Height="44" Margin="0,0,0,12"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource OnSurfaceMuted}" />
                        <TextBlock x:Name="title" Text="{TemplateBinding Title}" Style="{StaticResource TitleMedium}"
                                   Foreground="{DynamicResource OnSurfaceMuted}" HorizontalAlignment="Center"
                                   TextAlignment="Center" Margin="0,0,0,6" />
                        <TextBlock x:Name="body" Text="{TemplateBinding Text}" Style="{StaticResource Body}"
                                   Foreground="{DynamicResource OnSurfaceMuted}" HorizontalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" />
                        <ContentPresenter x:Name="action" Content="{TemplateBinding Action}"
                                          HorizontalAlignment="Center" Margin="0,16,0,0" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Title" Value="">
                            <Setter TargetName="title" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="body" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Action" Value="{x:Null}">
                            <Setter TargetName="action" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type m3:ModalLayer}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type m3:ModalLayer}">
                    <Grid>
                        <ContentPresenter />
                        <Border x:Name="PART_Scrim" Panel.ZIndex="1" Visibility="Collapsed" Opacity="0"
                                Margin="{TemplateBinding m3:ModalLayer.ChromeInset}"
                                Background="{DynamicResource Scrim}" />
                        <Grid x:Name="PART_ModalHost" Panel.ZIndex="2"
                              Margin="{TemplateBinding m3:ModalLayer.ChromeInset}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource OutlineVariant}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="DividerVertical" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Background" Value="{DynamicResource OutlineVariant}" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="M3CheckBox" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="18" Height="18" VerticalAlignment="Center">
                            <Ellipse x:Name="halo" Width="36" Height="36" Fill="{DynamicResource OnSurface}" Opacity="0" />
                            <Border x:Name="box" CornerRadius="2" BorderThickness="2"
                                    BorderBrush="{DynamicResource OnSurfaceVariant}" Background="Transparent" />
                            <Grid x:Name="markGroup" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                                <Grid.RenderTransform><ScaleTransform x:Name="markScale" ScaleX="1" ScaleY="1" /></Grid.RenderTransform>
                                <Path x:Name="check" Data="M4,9.5 L7.5,13 L14,5" Stroke="{DynamicResource OnPrimary}"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                <Border x:Name="dash" Width="10" Height="2" CornerRadius="1" Visibility="Collapsed"
                                        Background="{DynamicResource OnPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                        <ContentPresenter x:Name="label" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{DynamicResource Primary}" />
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Primary}" />
                            <Setter TargetName="markGroup" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="markScale" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="markScale" Storyboard.TargetProperty="ScaleY" From="0" To="1" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="markScale" Storyboard.TargetProperty="ScaleX" To="0" Duration="0:0:0.1" />
                                        <DoubleAnimation Storyboard.TargetName="markScale" Storyboard.TargetProperty="ScaleY" To="0" Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="box" Property="Background" Value="{DynamicResource Primary}" />
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Primary}" />
                            <Setter TargetName="markGroup" Property="Visibility" Value="Visible" />
                            <Setter TargetName="check" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="dash" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="markScale" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="markScale" Storyboard.TargetProperty="ScaleY" From="0" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="markScale" Storyboard.TargetProperty="ScaleX" To="0" Duration="0:0:0.1" />
                                        <DoubleAnimation Storyboard.TargetName="markScale" Storyboard.TargetProperty="ScaleY" To="0" Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="halo" Storyboard.TargetProperty="Opacity" To="0.08" Duration="0:0:0.1" /></Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="halo" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" /></Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="label" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type m3:Fab}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource OnPrimaryContainer}" />
        <Setter Property="Height" Value="56" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="0" />
        <Setter Property="ToolTipService.Placement" Value="Top" />
        <Setter Property="ToolTipService.ShowDuration" Value="60000" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type m3:Fab}">
                    <Border x:Name="b" Background="{DynamicResource PrimaryContainer}" CornerRadius="{StaticResource RadiusLg}"
                            Effect="{StaticResource Elevation3}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.13"><VisualTransition.GeneratedEasingFunction><StaticResource ResourceKey="M3StandardDecelerate" /></VisualTransition.GeneratedEasingFunction></VisualTransition>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="MouseOver"><Storyboard><DoubleAnimation Storyboard.TargetName="state" Storyboard.TargetProperty="Opacity" To="0.08" Duration="0" /></Storyboard></VisualState>
                                <VisualState x:Name="Pressed"><Storyboard><DoubleAnimation Storyboard.TargetName="state" Storyboard.TargetProperty="Opacity" To="0.12" Duration="0" /></Storyboard></VisualState>
                                <VisualState x:Name="Disabled"><Storyboard><DoubleAnimation Storyboard.TargetName="state" Storyboard.TargetProperty="Opacity" To="0" Duration="0" /></Storyboard></VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid>
                            <Border x:Name="state" Background="{DynamicResource OnPrimaryContainer}" Opacity="0"
                                    CornerRadius="{StaticResource RadiusLg}" />
                            <StackPanel x:Name="row" Orientation="Horizontal" Margin="20,0"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <m3:PathIcon x:Name="icon" Width="24" Height="24" VerticalAlignment="Center"
                                           Glyph="{TemplateBinding Glyph}" Foreground="{TemplateBinding Foreground}" />
                                <ContentPresenter x:Name="label" Margin="12,0,0,0" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource ButtonLabel}" />
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Size" Value="Small">
                            <Setter Property="Height" Value="40" />
                            <Setter Property="MinWidth" Value="56" />
                            <Setter TargetName="b" Property="CornerRadius" Value="{StaticResource RadiusMd}" />
                            <Setter TargetName="state" Property="CornerRadius" Value="{StaticResource RadiusMd}" />
                            <Setter TargetName="icon" Property="Width" Value="20" />
                            <Setter TargetName="icon" Property="Height" Value="20" />
                            <Setter TargetName="row" Property="Margin" Value="16,0" />
                        </Trigger>
                        <Trigger Property="Size" Value="Large">
                            <Setter Property="Height" Value="96" />
                            <Setter Property="MinWidth" Value="112" />
                            <Setter TargetName="b" Property="CornerRadius" Value="{StaticResource RadiusXl}" />
                            <Setter TargetName="state" Property="CornerRadius" Value="{StaticResource RadiusXl}" />
                            <Setter TargetName="icon" Property="Width" Value="32" />
                            <Setter TargetName="icon" Property="Height" Value="32" />
                            <Setter TargetName="row" Property="Margin" Value="28,0" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="label" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="row" Property="Margin" Value="0" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="Width" Value="56" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Content" Value="{x:Null}" />
                                <Condition Property="Size" Value="Small" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Width" Value="40" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Content" Value="{x:Null}" />
                                <Condition Property="Size" Value="Large" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Width" Value="96" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource SurfaceContainerHighest}" />
                            <Setter TargetName="b" Property="Effect" Value="{x:Null}" />
                            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceMuted}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type m3:ListTile}">
        <Setter Property="Height" Value="72" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type m3:ListTile}">
                    <Border x:Name="b" Background="Transparent" CornerRadius="{StaticResource RadiusMd}">
                        <Grid Margin="16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="leading" Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center"
                                              Content="{TemplateBinding Leading}" />
                            <m3:PathIcon x:Name="icon" Grid.Column="0" Width="24" Height="24" Margin="0,0,16,0"
                                       VerticalAlignment="Center" Visibility="Collapsed"
                                       Glyph="{TemplateBinding Glyph}" Foreground="{DynamicResource OnSurfaceVariant}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="headline" Text="{TemplateBinding Headline}" Style="{StaticResource Body}"
                                           Foreground="{DynamicResource OnSurface}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="support" Text="{TemplateBinding SupportingText}" Style="{StaticResource BodySmall}"
                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock x:Name="trailingText" Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center"
                                       Visibility="Collapsed"
                                       Text="{TemplateBinding TrailingText}" Style="{StaticResource BodySmall}" />
                            <ContentPresenter x:Name="trailing" Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center"
                                              Content="{TemplateBinding Trailing}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SupportingText" Value="">
                            <Setter Property="Height" Value="56" />
                            <Setter TargetName="support" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Leading" Value="{x:Null}">
                            <Setter TargetName="leading" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="icon" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Glyph" Value="{x:Null}">
                            <Setter TargetName="icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Trailing" Value="{x:Null}">
                            <Setter TargetName="trailing" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="trailingText" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="TrailingText" Value="">
                            <Setter TargetName="trailingText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource SurfaceContainerHigh}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource SecondaryContainer}" />
                            <Setter TargetName="headline" Property="Foreground" Value="{DynamicResource OnSecondaryContainer}" />
                            <Setter TargetName="support" Property="Foreground" Value="{DynamicResource OnSecondaryContainer}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type m3:SegmentedButton}">
        <Setter Property="Height" Value="40" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type m3:SegmentedButton}">
                    <Border BorderThickness="1" BorderBrush="{DynamicResource Outline}" CornerRadius="{StaticResource RadiusPill}"
                            Background="Transparent" SnapsToDevicePixels="True">
                        <Border.Clip>
                            <MultiBinding Converter="{StaticResource RoundedClip}" ConverterParameter="20">
                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                                <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                            </MultiBinding>
                        </Border.Clip>
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type m3:SegmentedItem}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="MinWidth" Value="72" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type m3:SegmentedItem}">
                    <Border x:Name="b" Background="Transparent" BorderThickness="1,0,0,0"
                            BorderBrush="{DynamicResource Outline}" SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="state" Background="{DynamicResource OnSurface}" Opacity="0" />
                            <ContentPresenter x:Name="c" Margin="16,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource ButtonLabel}" />
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Position" Value="First">
                            <Setter TargetName="b" Property="BorderThickness" Value="0" />
                        </Trigger>
                        <Trigger Property="Position" Value="Only">
                            <Setter TargetName="b" Property="BorderThickness" Value="0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="state" Property="Opacity" Value="0.08" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource SecondaryContainer}" />
                            <Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainer}" />
                            <Setter TargetName="state" Property="Background" Value="{DynamicResource OnSecondaryContainer}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="M3Slider" TargetType="Slider">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="m3:SliderMotion.IsAnimated" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid x:Name="PART_Area" Background="Transparent" MinHeight="32" ClipToBounds="False">
                        <Border Height="6" CornerRadius="3" VerticalAlignment="Center"
                                Background="{DynamicResource SurfaceContainerHighest}" />
                        <Border x:Name="PART_Active" Height="6" Width="0" CornerRadius="3" VerticalAlignment="Center"
                                HorizontalAlignment="Left" Background="{DynamicResource Primary}" />
                        <Canvas ClipToBounds="False">
                            <Grid x:Name="PART_Thumb" Width="32" Height="32" IsHitTestVisible="False">
                                <Ellipse x:Name="halo" Width="32" Height="32" Fill="{DynamicResource Primary}" Opacity="0" />
                                <Ellipse Width="20" Height="20" Fill="{DynamicResource Primary}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Canvas>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="halo" Storyboard.TargetProperty="Opacity" To="0.12" Duration="0:0:0.1" /></Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="halo" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" /></Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type m3:CircularProgress}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IndicatorBrush" Value="{DynamicResource Primary}" />
        <Setter Property="TrackBrush" Value="{DynamicResource SurfaceContainerHighest}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type m3:CircularProgress}">
                    <Grid Width="{TemplateBinding Diameter}" Height="{TemplateBinding Diameter}">
                        <Path x:Name="PART_Track" Stroke="{TemplateBinding TrackBrush}"
                              StrokeThickness="{TemplateBinding StrokeThickness}" />
                        <Grid x:Name="PART_Spin" RenderTransformOrigin="0.5,0.5">
                            <Path x:Name="PART_Indicator" Stroke="{TemplateBinding IndicatorBrush}"
                                  StrokeThickness="{TemplateBinding StrokeThickness}" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Track" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type m3:Snackbar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type m3:Snackbar}">
                    <Border Background="{DynamicResource InverseSurface}" CornerRadius="{StaticResource RadiusXs}"
                            MinHeight="48" MinWidth="288" MaxWidth="560" Effect="{StaticResource Elevation3}">
                        <Grid Margin="16,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{TemplateBinding Text}" TextWrapping="Wrap"
                                       VerticalAlignment="Center" FontSize="14"
                                       Foreground="{DynamicResource InverseOnSurface}" />
                            <Button x:Name="PART_Action" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                                    Cursor="Hand" Content="{TemplateBinding ActionText}"
                                    Foreground="{DynamicResource InversePrimary}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" Padding="8,4">
                                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}">
                                                <ContentPresenter.Resources>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource ButtonLabel}" />
                                                </ContentPresenter.Resources>
                                            </ContentPresenter>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ActionText" Value="{x:Null}">
                            <Setter TargetName="PART_Action" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type m3:ColorField}">
        <Style.Resources>
            <DrawingBrush x:Key="Checkerboard" TileMode="Tile" Viewport="0,0,10,10" ViewportUnits="Absolute" Stretch="None">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="#FF9A9A9A">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,10,10" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="#FF6E6E6E">
                            <GeometryDrawing.Geometry>
                                <GeometryGroup>
                                    <RectangleGeometry Rect="0,0,5,5" />
                                    <RectangleGeometry Rect="5,5,5,5" />
                                </GeometryGroup>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>
            <LinearGradientBrush x:Key="HueTrack" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0.000" Color="#FFFF0000" />
                <GradientStop Offset="0.167" Color="#FFFFFF00" />
                <GradientStop Offset="0.333" Color="#FF00FF00" />
                <GradientStop Offset="0.500" Color="#FF00FFFF" />
                <GradientStop Offset="0.667" Color="#FF0000FF" />
                <GradientStop Offset="0.833" Color="#FFFF00FF" />
                <GradientStop Offset="1.000" Color="#FFFF0000" />
            </LinearGradientBrush>
            <Style x:Key="Rail" TargetType="Slider">
                <Setter Property="Height" Value="20" />
                <Setter Property="IsMoveToPointEnabled" Value="True" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid>
                                <Border Height="12" VerticalAlignment="Center" CornerRadius="6"
                                        Background="{TemplateBinding Background}"
                                        BorderThickness="1" BorderBrush="{DynamicResource OutlineVariant}" />
                                <Track x:Name="PART_Track">
                                    <Track.Thumb>
                                        <Thumb Width="16" Height="20">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="{DynamicResource Surface}" CornerRadius="8"
                                                            BorderThickness="2" BorderBrush="{DynamicResource OnSurface}" />
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Opacity="0" Focusable="False" Background="Transparent" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Opacity="0" Focusable="False" Background="Transparent" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Style.Resources>
        <Setter Property="Height" Value="40" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type m3:ColorField}">
                    <Border CornerRadius="{StaticResource RadiusSm}"
                            Background="{DynamicResource SurfaceContainerHighest}" Padding="6,0,12,0">
                        <DockPanel LastChildFill="True">

                            <Button x:Name="PART_Swatch" DockPanel.Dock="Left" Width="28" Height="28"
                                    VerticalAlignment="Center" Margin="0,0,10,0" Cursor="Arrow" Focusable="False"
                                    m3:Tip.Text="{TemplateBinding HexText}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Border CornerRadius="{StaticResource RadiusXs}" Background="{StaticResource Checkerboard}" />
                                            <Border CornerRadius="{StaticResource RadiusXs}" BorderThickness="1"
                                                    BorderBrush="{DynamicResource OutlineVariant}">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{Binding Color, RelativeSource={RelativeSource AncestorType={x:Type m3:ColorField}}}" />
                                                </Border.Background>
                                            </Border>
                                            <Border x:Name="State" CornerRadius="{StaticResource RadiusXs}"
                                                    Background="{DynamicResource OnSurface}" Opacity="0" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="State" Property="Opacity" Value="0.08" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="State" Property="Opacity" Value="0.12" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <TextBlock x:Name="Caption" VerticalAlignment="Center"
                                       Foreground="{DynamicResource OnSurfaceVariant}" TextTrimming="CharacterEllipsis"
                                       Text="{TemplateBinding ReadOnlyCaption}" />

                            <TextBox x:Name="PART_Hex" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                     BorderThickness="0" Background="Transparent" Padding="0" Visibility="Collapsed"
                                     Foreground="{DynamicResource OnSurface}" CaretBrush="{DynamicResource OnSurface}"
                                     FontFamily="Consolas" />

                            <m3:AnimatedPopup x:Name="PART_Popup" PlacementTarget="{Binding ElementName=PART_Swatch}"
                                              Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                <m3:PopupCard Margin="0,8,10,10" Width="268">
                                    <StackPanel>

                                        <Grid x:Name="PART_Plane" Height="160" Cursor="Cross" ClipToBounds="True" Background="Transparent">
                                            <Border CornerRadius="{StaticResource RadiusXs}">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{Binding HueColor, RelativeSource={RelativeSource AncestorType={x:Type m3:ColorField}}}" />
                                                </Border.Background>
                                            </Border>
                                            <Border CornerRadius="{StaticResource RadiusXs}">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Offset="0" Color="#FFFFFFFF" />
                                                        <GradientStop Offset="1" Color="#00FFFFFF" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border CornerRadius="{StaticResource RadiusXs}">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Offset="0" Color="#00000000" />
                                                        <GradientStop Offset="1" Color="#FF000000" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Ellipse x:Name="PART_PlaneThumb" Width="14" Height="14"
                                                     HorizontalAlignment="Left" VerticalAlignment="Top"
                                                     IsHitTestVisible="False" StrokeThickness="2"
                                                     Stroke="{DynamicResource Surface}">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.6" />
                                                </Ellipse.Effect>
                                            </Ellipse>
                                        </Grid>

                                        <Slider x:Name="PART_Hue" Style="{StaticResource Rail}"
                                                Margin="0,14,0,0" Minimum="0" Maximum="360"
                                                Background="{StaticResource HueTrack}" />

                                        <Grid x:Name="AlphaRow" Margin="0,10,0,0">
                                            <Border Height="12" VerticalAlignment="Center" CornerRadius="6"
                                                    Background="{StaticResource Checkerboard}" />
                                            <Slider x:Name="PART_Alpha" Style="{StaticResource Rail}" Minimum="0" Maximum="255">
                                                <Slider.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Offset="0" Color="#00000000" />
                                                        <GradientStop Offset="1"
                                                                      Color="{Binding OpaqueColor, RelativeSource={RelativeSource AncestorType={x:Type m3:ColorField}}}" />
                                                    </LinearGradientBrush>
                                                </Slider.Background>
                                            </Slider>
                                        </Grid>

                                    </StackPanel>
                                </m3:PopupCard>
                            </m3:AnimatedPopup>
                        </DockPanel>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowAlpha" Value="False">
                            <Setter TargetName="AlphaRow" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ReadOnlyCaption" Value="{x:Null}">
                            <Setter TargetName="Caption" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_Hex" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_Swatch" Property="Cursor" Value="Hand" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="PART_Hex" Property="IsReadOnly" Value="True" />
                            <Setter TargetName="PART_Hex" Property="Foreground" Value="{DynamicResource OnSurfaceVariant}" />
                            <Setter TargetName="PART_Swatch" Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type m3:ValueListEditor}">
        <Style.Resources>
            <BooleanToVisibilityConverter x:Key="Visible" />
            <ItemsPanelTemplate x:Key="OneLine">
                <UniformGrid Rows="1" />
            </ItemsPanelTemplate>
        </Style.Resources>
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type m3:ValueListEditor}">
                    <StackPanel>
                        <TextBlock Text="{TemplateBinding EmptyText}" Style="{StaticResource BodyDense}" TextWrapping="Wrap"
                                   Margin="0,0,0,8" Foreground="{DynamicResource OnSurfaceMuted}"
                                   Visibility="{Binding IsEmpty, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Visible}}" />

                        <ItemsControl x:Name="PART_Items"
                                      ItemsSource="{Binding Rows, RelativeSource={RelativeSource TemplatedParent}}"
                                      MaxHeight="{Binding RowsScrollHeight, RelativeSource={RelativeSource TemplatedParent}}"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer CanContentScroll="True" Focusable="False"
                                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                                  m3:AutoHideScroll.IsEnabled="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,6,6">
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource BodySmall}" Margin="2,0,0,3"
                                                   Visibility="{Binding HasLabel, Converter={StaticResource Visible}}" />
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0"
                                                        Visibility="{Binding IsGrowable, RelativeSource={RelativeSource AncestorType={x:Type m3:ValueListEditor}}, Converter={StaticResource Visible}}">
                                                <Button Style="{StaticResource RowIconButton}"
                                                        Command="{x:Static m3:ValueListEditor.MoveRowUpCommand}" CommandParameter="{Binding}">
                                                    <m3:PathIcon Glyph="ChevronUp" Width="16" Height="16" />
                                                </Button>
                                                <Button Style="{StaticResource RowIconButton}"
                                                        Command="{x:Static m3:ValueListEditor.MoveRowDownCommand}" CommandParameter="{Binding}">
                                                    <m3:PathIcon Glyph="ChevronDown" Width="16" Height="16" />
                                                </Button>
                                                <Button Style="{StaticResource RowIconButton}"
                                                        Command="{x:Static m3:ValueListEditor.RemoveRowCommand}" CommandParameter="{Binding}">
                                                    <m3:PathIcon Glyph="Close" Width="16" Height="16" />
                                                </Button>
                                            </StackPanel>
                                            <Border Height="40" CornerRadius="{StaticResource RadiusSm}" Padding="12,0,12,0"
                                                    Background="{DynamicResource SurfaceContainerHighest}">
                                                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                         BorderThickness="0" Background="Transparent" Padding="0"
                                                         VerticalContentAlignment="Center"
                                                         Foreground="{DynamicResource OnSurface}" CaretBrush="{DynamicResource OnSurface}"
                                                         m3:InputFilter.Kind="{Binding Kind, RelativeSource={RelativeSource AncestorType={x:Type m3:ValueListEditor}}}"
                                                         m3:Placeholder.Text="{Binding Placeholder, RelativeSource={RelativeSource AncestorType={x:Type m3:ValueListEditor}}}" />
                                            </Border>
                                        </DockPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button HorizontalAlignment="Left" Margin="0,2,0,0" Style="{StaticResource TextButton}"
                                Command="{x:Static m3:ValueListEditor.AddRowCommand}"
                                Visibility="{Binding IsGrowable, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Visible}}">
                            <StackPanel Orientation="Horizontal">
                                <m3:PathIcon Glyph="Plus" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{TemplateBinding AddText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Items" Property="ItemsPanel" Value="{StaticResource OneLine}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type m3:DataTableEditor}">
        <Style.Resources>
            <BooleanToVisibilityConverter x:Key="Visible" />
            <ItemsPanelTemplate x:Key="Cells">
                <UniformGrid Rows="1" />
            </ItemsPanelTemplate>
        </Style.Resources>
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type m3:DataTableEditor}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <Border DockPanel.Dock="Left" Width="30"
                                    Visibility="{Binding IsSelectable, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Visible}}" />
                            <Border DockPanel.Dock="Right" Width="28"
                                    Visibility="{Binding CanRemoveRows, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Visible}}" />
                            <ItemsControl ItemsSource="{Binding Columns, RelativeSource={RelativeSource TemplatedParent}}"
                                          ItemsPanel="{StaticResource Cells}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Header}" Style="{StaticResource Caption}" Margin="10,0,6,0"
                                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource OnSurfaceMuted}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>

                        <ItemsControl x:Name="PART_Rows"
                                      ItemsSource="{Binding Rows, RelativeSource={RelativeSource TemplatedParent}}"
                                      MaxHeight="{Binding RowsScrollHeight, RelativeSource={RelativeSource TemplatedParent}}"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer CanContentScroll="True" Focusable="False"
                                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                                  m3:AutoHideScroll.IsEnabled="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel x:Name="row" Margin="0,0,0,4">
                                        <CheckBox DockPanel.Dock="Left" Width="30" IsChecked="{Binding Included}"
                                                  VerticalAlignment="Center" Style="{StaticResource M3CheckBox}"
                                                  Visibility="{Binding IsSelectable, RelativeSource={RelativeSource AncestorType={x:Type m3:DataTableEditor}}, Converter={StaticResource Visible}}" />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource RowIconButton}"
                                                Command="{x:Static m3:DataTableEditor.RemoveRowCommand}" CommandParameter="{Binding}"
                                                Visibility="{Binding CanRemoveRows, RelativeSource={RelativeSource AncestorType={x:Type m3:DataTableEditor}}, Converter={StaticResource Visible}}">
                                            <m3:PathIcon Glyph="Close" Width="15" Height="15" />
                                        </Button>
                                        <ItemsControl ItemsSource="{Binding Cells}" ItemsPanel="{StaticResource Cells}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="cell" Height="40" Margin="0,0,4,0" Padding="10,0,10,0"
                                                            CornerRadius="{StaticResource RadiusSm}"
                                                            Background="{DynamicResource SurfaceContainerHighest}">
                                                        <Grid>
                                                            <TextBox x:Name="entry"
                                                                     Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                                     BorderThickness="0" Background="Transparent"
                                                                     Padding="0" VerticalContentAlignment="Center"
                                                                     Foreground="{DynamicResource OnSurface}" CaretBrush="{DynamicResource OnSurface}"
                                                                     m3:InputFilter.Kind="{Binding Column.Kind}" />
                                                            <TextBlock x:Name="shown" Text="{Binding Text}"
                                                                       VerticalAlignment="Center" Visibility="Collapsed"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource OnSurfaceVariant}" />
                                                        </Grid>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsWritable}" Value="False">
                                                            <Setter TargetName="entry" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="shown" Property="Visibility" Value="Visible" />
                                                            <Setter TargetName="cell" Property="Background" Value="Transparent" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DockPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Included}" Value="False">
                                            <Setter TargetName="row" Property="Opacity" Value="0.45" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button HorizontalAlignment="Left" Margin="0,2,0,0" Style="{StaticResource TextButton}"
                                Command="{x:Static m3:DataTableEditor.AddRowCommand}"
                                Visibility="{Binding CanAddRows, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Visible}}">
                            <StackPanel Orientation="Horizontal">
                                <m3:PathIcon Glyph="Plus" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{TemplateBinding AddText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="M3ComboItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="b" Background="Transparent" CornerRadius="{StaticResource RadiusSm}" Padding="11,8" Margin="0,1">
                        <Grid>
                            <Border x:Name="sel" Background="{DynamicResource SecondaryContainer}" Opacity="0"
                                    CornerRadius="{StaticResource RadiusSm}" Margin="-11,-8" />
                            <Border x:Name="st" Background="{DynamicResource SurfaceContainerHighest}" Opacity="0"
                                    CornerRadius="{StaticResource RadiusSm}" Margin="-11,-8" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="st" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.13" EasingFunction="{StaticResource M3StandardDecelerate}" /></Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="st" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.13" EasingFunction="{StaticResource M3StandardAccelerate}" /></Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainer}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="sel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" EasingFunction="{StaticResource M3StandardDecelerate}" /></Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="sel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" EasingFunction="{StaticResource M3StandardAccelerate}" /></Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="M3Combo" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
        <Setter Property="Height" Value="40" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource M3FocusRing}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource M3ComboItem}" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="box" Background="{DynamicResource SurfaceContainerHighest}" CornerRadius="{StaticResource RadiusSm}"
                                BorderBrush="{DynamicResource OutlineVariant}" BorderThickness="1">
                            <Grid>
                                <Border x:Name="st" Background="{DynamicResource OnSurface}" Opacity="0" CornerRadius="{StaticResource RadiusSm}" />
                                <DockPanel Margin="14,0,8,0">
                                    <m3:PathIcon DockPanel.Dock="Right" Glyph="ChevronDown" Width="20" Height="20" VerticalAlignment="Center"
                                                 Foreground="{DynamicResource OnSurfaceVariant}"
                                                 m3:Chevron.IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <Grid VerticalAlignment="Center">
                                        <TextBlock x:Name="hint" Text="{Binding Path=(m3:Placeholder.Text), RelativeSource={RelativeSource TemplatedParent}}"
                                                   Foreground="{DynamicResource OnSurfaceMuted}" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                          TextElement.Foreground="{TemplateBinding Foreground}" IsHitTestVisible="False" />
                                    </Grid>
                                </DockPanel>
                            </Grid>
                        </Border>
                        <ToggleButton Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <m3:AnimatedPopup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                                          m3:CenterPopup.IsEnabled="True" AllowsTransparency="True" Focusable="False" StaysOpen="False"
                                          PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                            <m3:PopupCard Margin="10,0,10,10">
                                <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" Focusable="False"
                                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </m3:PopupCard>
                        </m3:AnimatedPopup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SelectedItem" Value="{x:Null}">
                            <Setter TargetName="hint" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="st" Property="Opacity" Value="0.08" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Primary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type m3:Badge}">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type m3:Badge}">
                    <Grid x:Name="PART_Root">
                        <Border x:Name="pill" MinWidth="16" Height="16" CornerRadius="8" Padding="4,0" Background="{DynamicResource Error}">
                            <TextBlock Text="{TemplateBinding Text}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="{DynamicResource OnError}" />
                        </Border>
                        <Ellipse x:Name="dot" Width="6" Height="6" Fill="{DynamicResource Error}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="pill" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsDot" Value="True">
                            <Setter TargetName="pill" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type m3:SearchBar}">
        <Setter Property="Height" Value="48" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type m3:SearchBar}">
                    <Border x:Name="bg" CornerRadius="24" Background="{DynamicResource SurfaceContainerHigh}">
                        <Grid>
                            <Border x:Name="st" CornerRadius="24" Background="{DynamicResource OnSurface}" Opacity="0" />
                            <DockPanel Margin="16,0,8,0">
                                <m3:PathIcon DockPanel.Dock="Left" Glyph="Magnify" Width="20" Height="20" Margin="0,0,12,0"
                                             VerticalAlignment="Center" Foreground="{DynamicResource OnSurfaceVariant}" />
                                <Button x:Name="PART_Clear" DockPanel.Dock="Right" Style="{StaticResource RowIconButton}" Width="32" Height="32"
                                        m3:Tip.Text="Clear">
                                    <m3:PathIcon Glyph="Close" Width="18" Height="18" />
                                </Button>
                                <TextBox x:Name="PART_Editor" VerticalAlignment="Center" BorderThickness="0" Background="Transparent" Padding="0"
                                         FontSize="16" Text="{Binding Query, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                                         m3:Placeholder.Text="{TemplateBinding Placeholder}" />
                            </DockPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="st" Property="Opacity" Value="0.08" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Text.Length, ElementName=PART_Editor}" Value="0">
                            <Setter TargetName="PART_Clear" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type m3:Tabs}">
        <Style.Resources>
            <Style TargetType="TabItem">
                <Setter Property="Height" Value="48" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="MinWidth" Value="90" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource M3FocusRing}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Grid Background="Transparent">
                                <Border x:Name="st" Background="{DynamicResource OnSurface}" Opacity="0" />
                                <ContentPresenter x:Name="label" ContentSource="Header" Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource ButtonLabel}" />
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="st" Property="Opacity" Value="0.08" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
                                </Trigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                        <Condition Binding="{Binding Variant, RelativeSource={RelativeSource AncestorType={x:Type m3:Tabs}}}" Value="Primary" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Foreground" Value="{DynamicResource Primary}" />
                                </MultiDataTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.38" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Style.Resources>
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type m3:Tabs}">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Orientation="Horizontal" IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                            <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource OutlineVariant}" IsHitTestVisible="False" />
                            <Canvas x:Name="track" Height="3" VerticalAlignment="Bottom" IsHitTestVisible="False">
                                <Border x:Name="PART_Indicator" Height="3" CornerRadius="3,3,0,0" Background="{DynamicResource Primary}" Visibility="Collapsed" />
                            </Canvas>
                        </Grid>
                        <ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"
                                          Margin="{TemplateBinding Padding}" KeyboardNavigation.TabIndex="2" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Variant" Value="Secondary">
                            <Setter TargetName="track" Property="Height" Value="2" />
                            <Setter TargetName="PART_Indicator" Property="Height" Value="2" />
                            <Setter TargetName="PART_Indicator" Property="CornerRadius" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type m3:TextField}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type m3:TextField}">
                    <StackPanel>
                        <Grid x:Name="field" Height="56">
                            <Border x:Name="fill" CornerRadius="4,4,0,0" Background="{DynamicResource SurfaceContainerHighest}" />
                            <Border x:Name="st" CornerRadius="4,4,0,0" Background="{DynamicResource OnSurface}" Opacity="0" />
                            <Border x:Name="indicator" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource OnSurfaceVariant}" />
                            <m3:NotchedOutline x:Name="PART_Outline" Stroke="{DynamicResource Outline}" StrokeThickness="1" Radius="4" Visibility="Collapsed" />
                            <DockPanel x:Name="content" Margin="16,0">
                                <m3:PathIcon x:Name="leadIcon" DockPanel.Dock="Left" Glyph="{TemplateBinding LeadingGlyph}" Width="20" Height="20"
                                             Margin="-4,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource OnSurfaceVariant}" />
                                <Button x:Name="PART_Trailing" DockPanel.Dock="Right" Style="{StaticResource RowIconButton}" Width="32" Height="32" Margin="8,0,-8,0">
                                    <m3:PathIcon Glyph="{TemplateBinding TrailingGlyph}" Width="20" Height="20" />
                                </Button>
                                <Grid>
                                    <TextBox x:Name="PART_Editor" VerticalAlignment="Center" BorderThickness="0" Background="Transparent" Padding="0"
                                             FontSize="16" Margin="-2,16,0,0"
                                             Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{TemplateBinding IsReadOnly}" MaxLength="{TemplateBinding MaxLength}" />
                                    <PasswordBox x:Name="PART_Password" VerticalAlignment="Center" BorderThickness="0" Background="Transparent" Padding="0"
                                                 FontSize="16" Margin="-2,16,0,0" Visibility="Collapsed" MaxLength="{TemplateBinding MaxLength}"
                                                 Foreground="{DynamicResource OnSurface}" CaretBrush="{DynamicResource OnSurface}" FocusVisualStyle="{x:Null}">
                                        <PasswordBox.Template>
                                            <ControlTemplate TargetType="PasswordBox">
                                                <ScrollViewer x:Name="PART_ContentHost" />
                                            </ControlTemplate>
                                        </PasswordBox.Template>
                                    </PasswordBox>
                                </Grid>
                            </DockPanel>
                            <Canvas x:Name="labelHost" IsHitTestVisible="False" ClipToBounds="False">
                                <TextBlock x:Name="PART_Label" Text="{TemplateBinding Label}" FontSize="16"
                                           Foreground="{DynamicResource OnSurfaceVariant}"
                                           Canvas.Left="{Binding ActualWidth, ElementName=leadSpace}" Canvas.Top="17" />
                            </Canvas>
                            <Border x:Name="leadSpace" Width="16" HorizontalAlignment="Left" Visibility="Hidden" />
                        </Grid>
                        <TextBlock x:Name="PART_Line" Text="{TemplateBinding LineText}" FontSize="12" Margin="16,4,16,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource OnSurfaceVariant}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="LeadingGlyph" Value="{x:Null}">
                            <Setter TargetName="leadIcon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Visibility, ElementName=leadIcon}" Value="Visible">
                            <Setter TargetName="leadSpace" Property="Width" Value="44" />
                        </DataTrigger>
                        <Trigger Property="TrailingGlyph" Value="{x:Null}">
                            <Setter TargetName="PART_Trailing" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Label" Value="{x:Null}">
                            <Setter TargetName="PART_Editor" Property="Margin" Value="-2,0,0,0" />
                            <Setter TargetName="PART_Password" Property="Margin" Value="-2,0,0,0" />
                        </Trigger>
                        <Trigger Property="LineText" Value="{x:Null}">
                            <Setter TargetName="PART_Line" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsPassword" Value="True">
                            <Setter TargetName="PART_Editor" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_Password" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Variant" Value="Outlined">
                            <Setter TargetName="fill" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="st" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_Outline" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_Editor" Property="Margin" Value="-2,0,0,0" />
                            <Setter TargetName="PART_Password" Property="Margin" Value="-2,0,0,0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="st" Property="Opacity" Value="0.08" />
                            <Setter TargetName="indicator" Property="Background" Value="{DynamicResource OnSurface}" />
                            <Setter TargetName="PART_Outline" Property="Stroke" Value="{DynamicResource OnSurface}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="indicator" Property="Height" Value="2" />
                            <Setter TargetName="indicator" Property="Background" Value="{DynamicResource Primary}" />
                            <Setter TargetName="PART_Outline" Property="StrokeThickness" Value="2" />
                            <Setter TargetName="PART_Outline" Property="Stroke" Value="{DynamicResource Primary}" />
                            <Setter TargetName="PART_Label" Property="Foreground" Value="{DynamicResource Primary}" />
                        </Trigger>
                        <Trigger Property="IsError" Value="True">
                            <Setter TargetName="indicator" Property="Background" Value="{DynamicResource Error}" />
                            <Setter TargetName="PART_Outline" Property="Stroke" Value="{DynamicResource Error}" />
                            <Setter TargetName="PART_Label" Property="Foreground" Value="{DynamicResource Error}" />
                            <Setter TargetName="PART_Line" Property="Foreground" Value="{DynamicResource Error}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type m3:StepChecklist}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type m3:StepChecklist}">
                    <StackPanel x:Name="PART_Rows" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
