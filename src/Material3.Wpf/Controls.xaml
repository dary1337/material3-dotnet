        <Setter Property="Background" Value="{DynamicResource OutlineVariant}" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="M3CheckBox" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource M3FocusRing}" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
        <Setter Property="Padding" Value="10,0,0,0" />
        <Setter Property="m3:Metrics.IndicatorSize" Value="18,18" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Viewbox VerticalAlignment="Center"
                                 Width="{Binding Path=(m3:Metrics.IndicatorSize).Width, RelativeSource={RelativeSource TemplatedParent}}"
                                 Height="{Binding Path=(m3:Metrics.IndicatorSize).Height, RelativeSource={RelativeSource TemplatedParent}}">
                        <Grid Width="18" Height="18">
                            <Ellipse x:Name="halo" Width="36" Height="36" Fill="{DynamicResource OnSurface}" Opacity="0" />
                            <Border x:Name="box" CornerRadius="2" BorderThickness="2"
                                    BorderBrush="{DynamicResource OnSurfaceVariant}" Background="Transparent" />
                            <Grid x:Name="markGroup" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                                <Grid.RenderTransform><ScaleTransform x:Name="markScale" ScaleX="1" ScaleY="1" /></Grid.RenderTransform>
                                <Path x:Name="check" Data="M4,9.5 L7.5,13 L14,5" Stroke="{DynamicResource OnPrimary}"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                <Border x:Name="dash" Width="10" Height="2" CornerRadius="1" Visibility="Collapsed"
                                        Background="{DynamicResource OnPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                        </Viewbox>
                        <ContentPresenter x:Name="label" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{DynamicResource Primary}" />
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Primary}" />
                            <Setter TargetName="markGroup" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="markScale" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="markScale" Storyboard.TargetProperty="ScaleY" From="0" To="1" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="markScale" Storyboard.TargetProperty="ScaleX" To="0" Duration="0:0:0.1" />
                                        <DoubleAnimation Storyboard.TargetName="markScale" Storyboard.TargetProperty="ScaleY" To="0" Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="box" Property="Background" Value="{DynamicResource Primary}" />
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Primary}" />
                            <Setter TargetName="markGroup" Property="Visibility" Value="Visible" />
                            <Setter TargetName="check" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="dash" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="markScale" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="markScale" Storyboard.TargetProperty="ScaleY" From="0" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="markScale" Storyboard.TargetProperty="ScaleX" To="0" Duration="0:0:0.1" />
                                        <DoubleAnimation Storyboard.TargetName="markScale" Storyboard.TargetProperty="ScaleY" To="0" Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="halo" Storyboard.TargetProperty="Opacity" To="0.08" Duration="0:0:0.1" /></Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="halo" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" /></Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="label" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type m3:Fab}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource M3FocusRingLg}" />
        <Setter Property="Foreground" Value="{DynamicResource OnPrimaryContainer}" />
        <Setter Property="Height" Value="56" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="m3:Metrics.CornerRadius" Value="{DynamicResource RadiusLg}" />
        <Setter Property="m3:Metrics.GlyphSize" Value="24" />
        <Setter Property="m3:Metrics.GlyphMargin" Value="0,0,12,0" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="0" />
        <Setter Property="ToolTipService.Placement" Value="Top" />
        <Setter Property="ToolTipService.ShowDuration" Value="60000" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type m3:Fab}">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.13"><VisualTransition.GeneratedEasingFunction><StaticResource ResourceKey="M3StandardDecelerate" /></VisualTransition.GeneratedEasingFunction></VisualTransition>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="MouseOver"><Storyboard><DoubleAnimation Storyboard.TargetName="state" Storyboard.TargetProperty="Opacity" To="{StaticResource StateLayerHover}" Duration="0" /></Storyboard></VisualState>
                                <VisualState x:Name="Pressed"><Storyboard><DoubleAnimation Storyboard.TargetName="state" Storyboard.TargetProperty="Opacity" To="{StaticResource StateLayerPressed}" Duration="0" /></Storyboard></VisualState>
                                <VisualState x:Name="Disabled"><Storyboard><DoubleAnimation Storyboard.TargetName="state" Storyboard.TargetProperty="Opacity" To="0" Duration="0" /></Storyboard></VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <!-- The shadow is a layer of its own: an Effect on the face would rasterize the label. -->
                        <Border x:Name="shadow" Background="{DynamicResource PrimaryContainer}" CornerRadius="{m3:FitCornerRadius}"
                                Effect="{DynamicResource Elevation3}" />
                    <Border x:Name="b" Background="{DynamicResource PrimaryContainer}" CornerRadius="{m3:FitCornerRadius}">
                        <Grid>
                            <Border x:Name="state" Background="{DynamicResource OnPrimaryContainer}" Opacity="0"
                                    CornerRadius="{m3:FitCornerRadius}" />
                            <StackPanel x:Name="row" Orientation="Horizontal" Margin="{TemplateBinding Padding}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <m3:PathIcon x:Name="icon" Width="{TemplateBinding m3:Metrics.GlyphSize}" Height="{TemplateBinding m3:Metrics.GlyphSize}" Margin="{TemplateBinding m3:Metrics.GlyphMargin}" VerticalAlignment="Center"
                                           Glyph="{TemplateBinding Glyph}" Foreground="{TemplateBinding Foreground}" />
                                <ContentPresenter x:Name="label" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource ButtonLabel}" />
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </StackPanel>
                        </Grid>
                    </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="label" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="row" Property="Margin" Value="0" />
                            <Setter TargetName="icon" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource SurfaceContainerHighest}" />
                            <Setter TargetName="shadow" Property="Visibility" Value="Collapsed" />
                            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceMuted}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Size" Value="Small">
                <Setter Property="Height" Value="40" />
                <Setter Property="MinWidth" Value="56" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="m3:Metrics.CornerRadius" Value="{DynamicResource RadiusMd}" />
                <Setter Property="m3:Metrics.GlyphSize" Value="20" />
            </Trigger>
            <Trigger Property="Size" Value="Large">
                <Setter Property="Height" Value="96" />
                <Setter Property="MinWidth" Value="112" />
                <Setter Property="Padding" Value="28,0" />
                <Setter Property="m3:Metrics.CornerRadius" Value="{DynamicResource RadiusXl}" />
                <Setter Property="m3:Metrics.GlyphSize" Value="32" />
            </Trigger>
            <Trigger Property="Content" Value="{x:Null}">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Width" Value="56" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Content" Value="{x:Null}" />
                    <Condition Property="Size" Value="Small" />
                </MultiTrigger.Conditions>
                <Setter Property="Width" Value="40" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Content" Value="{x:Null}" />
                    <Condition Property="Size" Value="Large" />
                </MultiTrigger.Conditions>
                <Setter Property="Width" Value="96" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type m3:ListTile}">
        <Setter Property="Height" Value="72" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="m3:Metrics.CornerRadius" Value="{DynamicResource RadiusLg}" />
        <Setter Property="m3:Metrics.GlyphSize" Value="24" />
        <Setter Property="m3:Metrics.GlyphMargin" Value="0,0,16,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type m3:ListTile}">
                    <Border x:Name="b" Background="Transparent" CornerRadius="{m3:FitCornerRadius}">
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="leading" Grid.Column="0" Margin="{TemplateBinding m3:Metrics.GlyphMargin}" VerticalAlignment="Center"
                                              Content="{TemplateBinding Leading}" />
                            <m3:PathIcon x:Name="icon" Grid.Column="0" Width="{TemplateBinding m3:Metrics.GlyphSize}" Height="{TemplateBinding m3:Metrics.GlyphSize}" Margin="{TemplateBinding m3:Metrics.GlyphMargin}"
                                       VerticalAlignment="Center" Visibility="Collapsed"
                                       Glyph="{TemplateBinding Glyph}" Foreground="{DynamicResource OnSurfaceVariant}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="headline" Text="{TemplateBinding Headline}" Style="{DynamicResource BodyLarge}"
                                           Foreground="{DynamicResource OnSurface}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="support" Text="{TemplateBinding SupportingText}" Style="{DynamicResource BodyMedium}"
                                           Foreground="{DynamicResource OnSurfaceVariant}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock x:Name="trailingText" Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center"
                                       Visibility="Collapsed"
                                       Text="{TemplateBinding TrailingText}" Style="{DynamicResource LabelSmall}" Foreground="{DynamicResource OnSurfaceVariant}" />
                            <ContentPresenter x:Name="trailing" Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center"
                                              Content="{TemplateBinding Trailing}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SupportingText" Value="">
                            <Setter TargetName="support" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Leading" Value="{x:Null}">
                            <Setter TargetName="leading" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="icon" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Glyph" Value="{x:Null}">
                            <Setter TargetName="icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Trailing" Value="{x:Null}">
                            <Setter TargetName="trailing" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="trailingText" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="TrailingText" Value="">
                            <Setter TargetName="trailingText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource SurfaceContainerHigh}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="False">
                            <Setter TargetName="b" Property="CornerRadius" Value="0" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource SecondaryContainer}" />
                            <Setter TargetName="headline" Property="Foreground" Value="{DynamicResource OnSecondaryContainer}" />
                            <Setter TargetName="support" Property="Foreground" Value="{DynamicResource OnSecondaryContainer}" />
                            <Setter TargetName="trailingText" Property="Foreground" Value="{DynamicResource OnSecondaryContainer}" />
                            <Setter TargetName="icon" Property="Foreground" Value="{DynamicResource OnSecondaryContainer}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="SupportingText" Value=""><Setter Property="Height" Value="56" /></Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type m3:SegmentedButton}">
        <Setter Property="Height" Value="{DynamicResource ControlHeight}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="m3:Metrics.CornerRadius" Value="{DynamicResource RadiusPill}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type m3:SegmentedButton}">
                    <Border BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{DynamicResource Outline}" CornerRadius="{m3:FitCornerRadius}"
                            Background="Transparent" SnapsToDevicePixels="True">
                        <Border.Clip>
                            <MultiBinding Converter="{StaticResource RoundedClip}">
                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                                <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                                <Binding Path="(m3:Metrics.CornerRadius)" RelativeSource="{RelativeSource TemplatedParent}" />
                            </MultiBinding>
                        </Border.Clip>
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type m3:SegmentedItem}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource M3FocusRing}" />
        <Setter Property="MinWidth" Value="72" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightMedium}" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
        <Setter Property="m3:Metrics.GlyphSize" Value="16" />
        <Setter Property="m3:Metrics.GlyphMargin" Value="0,0,6,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type m3:SegmentedItem}">
                    <Border x:Name="b" Background="Transparent" BorderThickness="1,0,0,0"
                            BorderBrush="{DynamicResource Outline}" SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="state" Background="{DynamicResource OnSurface}" Opacity="0" />
                            <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <m3:PathIcon x:Name="check" Glyph="Check" Visibility="Collapsed" VerticalAlignment="Center"
                                             Width="{TemplateBinding m3:Metrics.GlyphSize}" Height="{TemplateBinding m3:Metrics.GlyphSize}"
                                             Margin="{TemplateBinding m3:Metrics.GlyphMargin}" Foreground="{TemplateBinding Foreground}" />
                                <ContentPresenter x:Name="c" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource ButtonLabel}" />
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Position" Value="First">
                            <Setter TargetName="b" Property="BorderThickness" Value="0" />
                        </Trigger>
                        <Trigger Property="Position" Value="Only">
                            <Setter TargetName="b" Property="BorderThickness" Value="0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="state" Property="Opacity" Value="0.08" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource SecondaryContainer}" />
                            <Setter TargetName="check" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainer}" />
                            <Setter TargetName="state" Property="Background" Value="{DynamicResource OnSecondaryContainer}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="M3Slider" TargetType="Slider">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource M3FocusRing}" />
        <Setter Property="m3:SliderMotion.IsAnimated" Value="True" />
        <Setter Property="m3:Metrics.IndicatorSize" Value="4,44" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid x:Name="PART_Area" Background="Transparent" MinHeight="44">
                        <Border x:Name="PART_Active" Height="{TemplateBinding m3:SliderMotion.TrackThickness}" Width="0"
                                VerticalAlignment="Center" HorizontalAlignment="Left" Background="{DynamicResource Primary}" />
                        <Border x:Name="PART_Inactive" Height="{TemplateBinding m3:SliderMotion.TrackThickness}"
                                VerticalAlignment="Center" HorizontalAlignment="Left" Background="{DynamicResource SecondaryContainer}" />
                        <Ellipse x:Name="PART_Stop" Width="4" Height="4" VerticalAlignment="Center" HorizontalAlignment="Right"
                                 Fill="{DynamicResource Primary}" />
                        <Canvas ClipToBounds="False">
                            <Border x:Name="PART_Thumb" IsHitTestVisible="False" Background="{DynamicResource Primary}"
                                    Height="{Binding Path=(m3:Metrics.IndicatorSize).Height, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Canvas>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Active" Property="Background" Value="{DynamicResource OnSurface}" />
                            <Setter TargetName="PART_Active" Property="Opacity" Value="0.38" />
                            <Setter TargetName="PART_Inactive" Property="Background" Value="{DynamicResource OnSurface}" />
                            <Setter TargetName="PART_Inactive" Property="Opacity" Value="0.12" />
                            <Setter TargetName="PART_Stop" Property="Fill" Value="{DynamicResource OnSurface}" />
                            <Setter TargetName="PART_Stop" Property="Opacity" Value="0.38" />
                            <Setter TargetName="PART_Thumb" Property="Background" Value="{DynamicResource OnSurface}" />
                            <Setter TargetName="PART_Thumb" Property="Opacity" Value="0.38" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type m3:CircularProgress}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IndicatorBrush" Value="{DynamicResource Primary}" />
        <Setter Property="TrackBrush" Value="{DynamicResource SecondaryContainer}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type m3:CircularProgress}">
                    <Grid Width="{TemplateBinding Diameter}" Height="{TemplateBinding Diameter}">
                        <Path x:Name="PART_Track" Stroke="{TemplateBinding TrackBrush}" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeThickness="{TemplateBinding StrokeThickness}" />
                        <Grid x:Name="PART_Spin" RenderTransformOrigin="0.5,0.5">
                            <Path x:Name="PART_Indicator" Stroke="{TemplateBinding IndicatorBrush}"
                                  StrokeThickness="{TemplateBinding StrokeThickness}" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Track" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type m3:Snackbar}">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="MinWidth" Value="288" />
        <Setter Property="MaxWidth" Value="560" />
        <Setter Property="m3:Metrics.CornerRadius" Value="{DynamicResource RadiusXs}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type m3:Snackbar}">
                    <Grid>
                    <Border Background="{DynamicResource InverseSurface}" CornerRadius="{m3:FitCornerRadius}"
                            Effect="{DynamicResource Elevation3}" />
                    <Border Background="{DynamicResource InverseSurface}" CornerRadius="{m3:FitCornerRadius}">
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{TemplateBinding Text}" TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource InverseOnSurface}" />
                            <Button x:Name="PART_Action" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                                    Cursor="Hand" Content="{TemplateBinding ActionText}"
                                    Foreground="{DynamicResource InversePrimary}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" Padding="8,4">
                                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}">
                                                <ContentPresenter.Resources>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource ButtonLabel}" />
                                                </ContentPresenter.Resources>
                                            </ContentPresenter>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ActionText" Value="{x:Null}">
                            <Setter TargetName="PART_Action" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type m3:ColorField}">
        <Style.Resources>
            <DrawingBrush x:Key="Checkerboard" TileMode="Tile" Viewport="0,0,10,10" ViewportUnits="Absolute" Stretch="None">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="#FF9A9A9A">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,10,10" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="#FF6E6E6E">
                            <GeometryDrawing.Geometry>
                                <GeometryGroup>
                                    <RectangleGeometry Rect="0,0,5,5" />
                                    <RectangleGeometry Rect="5,5,5,5" />
                                </GeometryGroup>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>
            <LinearGradientBrush x:Key="HueTrack" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0.000" Color="#FFFF0000" />
                <GradientStop Offset="0.167" Color="#FFFFFF00" />
                <GradientStop Offset="0.333" Color="#FF00FF00" />
                <GradientStop Offset="0.500" Color="#FF00FFFF" />
                <GradientStop Offset="0.667" Color="#FF0000FF" />
                <GradientStop Offset="0.833" Color="#FFFF00FF" />
                <GradientStop Offset="1.000" Color="#FFFF0000" />
            </LinearGradientBrush>
            <Style x:Key="Rail" TargetType="Slider">
                <Setter Property="Height" Value="20" />
                <Setter Property="IsMoveToPointEnabled" Value="True" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid>
                                <Border Height="12" VerticalAlignment="Center" CornerRadius="6"
                                        Background="{TemplateBinding Background}"
                                        BorderThickness="1" BorderBrush="{DynamicResource OutlineVariant}" />
                                <Track x:Name="PART_Track">
                                    <Track.Thumb>
                                        <Thumb Width="16" Height="20">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="{DynamicResource Surface}" CornerRadius="8"
                                                            BorderThickness="2" BorderBrush="{DynamicResource OnSurface}" />
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Opacity="0" Focusable="False" Background="Transparent" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Opacity="0" Focusable="False" Background="Transparent" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Style.Resources>
        <Setter Property="Height" Value="40" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Padding" Value="6,0,12,0" />
        <Setter Property="m3:Metrics.CornerRadius" Value="{DynamicResource RadiusSm}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type m3:ColorField}">
                    <Border CornerRadius="{m3:FitCornerRadius}"
                            Background="{DynamicResource SurfaceContainerHighest}" Padding="{TemplateBinding Padding}">
                        <DockPanel LastChildFill="True">

                            <Button x:Name="PART_Swatch" DockPanel.Dock="Left" Width="28" Height="28"
                                    VerticalAlignment="Center" Margin="0,0,10,0" Cursor="Arrow" Focusable="False"
                                    m3:Tip.Text="{TemplateBinding HexText}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Border CornerRadius="2" Background="{StaticResource Checkerboard}" />
                                            <Border CornerRadius="2" BorderThickness="1"
                                                    BorderBrush="{DynamicResource OutlineVariant}">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{Binding Color, RelativeSource={RelativeSource AncestorType={x:Type m3:ColorField}}}" />
                                                </Border.Background>
                                            </Border>
                                            <Border x:Name="State" CornerRadius="2"
                                                    Background="{DynamicResource OnSurface}" Opacity="0" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="State" Property="Opacity" Value="0.08" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="State" Property="Opacity" Value="0.12" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <TextBlock x:Name="Caption" VerticalAlignment="Center"
                                       Foreground="{DynamicResource OnSurfaceVariant}" TextTrimming="CharacterEllipsis"
                                       Text="{TemplateBinding ReadOnlyCaption}" />

                            <TextBox x:Name="PART_Hex" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                     BorderThickness="0" Background="Transparent" Padding="0" Visibility="Collapsed"
                                     Foreground="{DynamicResource OnSurface}" CaretBrush="{DynamicResource OnSurface}"
                                     FontFamily="Consolas" />

                            <m3:AnimatedPopup x:Name="PART_Popup" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                              m3:CenterPopup.IsEnabled="True" StaysOpen="False" AllowsTransparency="True">
                                <m3:PopupCard Margin="10,0,10,10" Width="268">
                                    <StackPanel Margin="4">

                                        <Grid x:Name="PART_Plane" Height="160" Cursor="Cross" ClipToBounds="True" Background="Transparent">
                                            <Border CornerRadius="{DynamicResource RadiusXs}">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{Binding HueColor, RelativeSource={RelativeSource AncestorType={x:Type m3:ColorField}}}" />
                                                </Border.Background>
                                            </Border>
                                            <Border CornerRadius="{DynamicResource RadiusXs}">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Offset="0" Color="#FFFFFFFF" />
                                                        <GradientStop Offset="1" Color="#00FFFFFF" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border CornerRadius="{DynamicResource RadiusXs}">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Offset="0" Color="#00000000" />
                                                        <GradientStop Offset="1" Color="#FF000000" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Ellipse x:Name="PART_PlaneThumb" Width="14" Height="14"
                                                     HorizontalAlignment="Left" VerticalAlignment="Top"
                                                     IsHitTestVisible="False" StrokeThickness="2"
                                                     Stroke="{DynamicResource Surface}">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.6" />
                                                </Ellipse.Effect>
                                            </Ellipse>
                                        </Grid>

                                        <Slider x:Name="PART_Hue" Style="{StaticResource Rail}"
                                                Margin="0,14,0,0" Minimum="0" Maximum="360"
                                                Background="{StaticResource HueTrack}" />

                                        <Grid x:Name="AlphaRow" Margin="0,10,0,0">
                                            <Border Height="12" VerticalAlignment="Center" CornerRadius="6"
                                                    Background="{StaticResource Checkerboard}" />
                                            <Slider x:Name="PART_Alpha" Style="{StaticResource Rail}" Minimum="0" Maximum="255">
                                                <Slider.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Offset="0" Color="#00000000" />
                                                        <GradientStop Offset="1"
                                                                      Color="{Binding OpaqueColor, RelativeSource={RelativeSource AncestorType={x:Type m3:ColorField}}}" />
                                                    </LinearGradientBrush>
                                                </Slider.Background>
                                            </Slider>
                                        </Grid>

                                    </StackPanel>
                                </m3:PopupCard>
                            </m3:AnimatedPopup>
                        </DockPanel>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowAlpha" Value="False">
                            <Setter TargetName="AlphaRow" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ReadOnlyCaption" Value="{x:Null}">
                            <Setter TargetName="Caption" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_Hex" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_Swatch" Property="Cursor" Value="Hand" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="PART_Hex" Property="IsReadOnly" Value="True" />
                            <Setter TargetName="PART_Hex" Property="Foreground" Value="{DynamicResource OnSurfaceVariant}" />
                            <Setter TargetName="PART_Swatch" Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type m3:ValueListEditor}">
        <Style.Resources>
            <BooleanToVisibilityConverter x:Key="Visible" />
            <ItemsPanelTemplate x:Key="OneLine">
                <UniformGrid Rows="1" />
            </ItemsPanelTemplate>
        </Style.Resources>
        <Setter Property="Focusable" Value="False" />
        <Setter Property="m3:Metrics.CornerRadius" Value="{DynamicResource RadiusSm}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type m3:ValueListEditor}">
                    <StackPanel>
                        <TextBlock Text="{TemplateBinding EmptyText}" Style="{DynamicResource BodyDense}" TextWrapping="Wrap"
                                   Margin="0,0,0,8" Foreground="{DynamicResource OnSurfaceMuted}"
                                   Visibility="{Binding IsEmpty, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Visible}}" />

                        <ItemsControl x:Name="PART_Items"
                                      ItemsSource="{Binding Rows, RelativeSource={RelativeSource TemplatedParent}}"
                                      MaxHeight="{Binding RowsScrollHeight, RelativeSource={RelativeSource TemplatedParent}}"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer CanContentScroll="True" Focusable="False"
                                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                                  m3:AutoHideScroll.IsEnabled="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,6,6">
                                        <TextBlock Text="{Binding Label}" Style="{DynamicResource BodySmall}" Margin="2,0,0,3"
                                                   Visibility="{Binding HasLabel, Converter={StaticResource Visible}}" />
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0"
                                                        Visibility="{Binding IsGrowable, RelativeSource={RelativeSource AncestorType={x:Type m3:ValueListEditor}}, Converter={StaticResource Visible}}">
                                                <Button Style="{StaticResource RowIconButton}"
                                                        Command="{x:Static m3:ValueListEditor.MoveRowUpCommand}" CommandParameter="{Binding}">
                                                    <m3:PathIcon Glyph="ChevronUp" Width="16" Height="16" />
                                                </Button>
                                                <Button Style="{StaticResource RowIconButton}"
                                                        Command="{x:Static m3:ValueListEditor.MoveRowDownCommand}" CommandParameter="{Binding}">
                                                    <m3:PathIcon Glyph="ChevronDown" Width="16" Height="16" />
                                                </Button>
                                                <Button Style="{StaticResource RowIconButton}"
                                                        Command="{x:Static m3:ValueListEditor.RemoveRowCommand}" CommandParameter="{Binding}">
                                                    <m3:PathIcon Glyph="Close" Width="16" Height="16" />
                                                </Button>
                                            </StackPanel>
                                            <Border Height="{Binding RowHeight, RelativeSource={RelativeSource AncestorType={x:Type m3:ValueListEditor}}}" Padding="12,0,12,0"
                                                    CornerRadius="{Binding Path=(m3:Metrics.CornerRadius), RelativeSource={RelativeSource AncestorType={x:Type m3:ValueListEditor}}}"
                                                    Background="{DynamicResource SurfaceContainerHighest}">
                                                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                         BorderThickness="0" Background="Transparent" Padding="0"
                                                         VerticalContentAlignment="Center"
                                                         Foreground="{DynamicResource OnSurface}" CaretBrush="{DynamicResource OnSurface}"
                                                         m3:InputFilter.Kind="{Binding Kind, RelativeSource={RelativeSource AncestorType={x:Type m3:ValueListEditor}}}"
                                                         m3:Placeholder.Text="{Binding Placeholder, RelativeSource={RelativeSource AncestorType={x:Type m3:ValueListEditor}}}" />
                                            </Border>
                                        </DockPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button HorizontalAlignment="Left" Margin="0,2,0,0" Style="{StaticResource TextButton}"
                                Command="{x:Static m3:ValueListEditor.AddRowCommand}"
                                Visibility="{Binding IsGrowable, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Visible}}">
                            <StackPanel Orientation="Horizontal">
                                <m3:PathIcon Glyph="Plus" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock x:Name="addText" Text="{TemplateBinding AddText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="AddText" Value="{x:Null}">
                            <Setter TargetName="addText" Property="Text" Value="{m3:Text Add}" />
                        </Trigger>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Items" Property="ItemsPanel" Value="{StaticResource OneLine}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type m3:DataTableEditor}">
        <Style.Resources>
            <BooleanToVisibilityConverter x:Key="Visible" />
            <ItemsPanelTemplate x:Key="Cells">
                <UniformGrid Rows="1" />
            </ItemsPanelTemplate>
        </Style.Resources>
        <Setter Property="Focusable" Value="False" />
        <Setter Property="m3:Metrics.CornerRadius" Value="{DynamicResource RadiusSm}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type m3:DataTableEditor}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <Border DockPanel.Dock="Left" Width="30"
                                    Visibility="{Binding IsSelectable, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Visible}}" />
                            <Border DockPanel.Dock="Right" Width="28"
                                    Visibility="{Binding CanRemoveRows, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Visible}}" />
                            <ItemsControl ItemsSource="{Binding Columns, RelativeSource={RelativeSource TemplatedParent}}"
                                          ItemsPanel="{StaticResource Cells}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Header}" Style="{DynamicResource Caption}" Margin="10,0,6,0"
                                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource OnSurfaceMuted}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>

                        <ItemsControl x:Name="PART_Rows"
                                      ItemsSource="{Binding Rows, RelativeSource={RelativeSource TemplatedParent}}"
                                      MaxHeight="{Binding RowsScrollHeight, RelativeSource={RelativeSource TemplatedParent}}"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer CanContentScroll="True" Focusable="False"
                                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                                  m3:AutoHideScroll.IsEnabled="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel x:Name="row" Margin="0,0,0,4">
                                        <CheckBox DockPanel.Dock="Left" Width="30" IsChecked="{Binding Included}"
                                                  VerticalAlignment="Center" Style="{StaticResource M3CheckBox}"
                                                  Visibility="{Binding IsSelectable, RelativeSource={RelativeSource AncestorType={x:Type m3:DataTableEditor}}, Converter={StaticResource Visible}}" />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource RowIconButton}"
                                                Command="{x:Static m3:DataTableEditor.RemoveRowCommand}" CommandParameter="{Binding}"
                                                Visibility="{Binding CanRemoveRows, RelativeSource={RelativeSource AncestorType={x:Type m3:DataTableEditor}}, Converter={StaticResource Visible}}">
                                            <m3:PathIcon Glyph="Close" Width="15" Height="15" />
                                        </Button>
                                        <ItemsControl ItemsSource="{Binding Cells}" ItemsPanel="{StaticResource Cells}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="cell" Margin="0,0,4,0" Padding="10,0,10,0"
                                                            Height="{Binding RowHeight, RelativeSource={RelativeSource AncestorType={x:Type m3:DataTableEditor}}}"
                                                            CornerRadius="{Binding Path=(m3:Metrics.CornerRadius), RelativeSource={RelativeSource AncestorType={x:Type m3:DataTableEditor}}}"
                                                            Background="{DynamicResource SurfaceContainerHighest}">
                                                        <Grid>
                                                            <TextBox x:Name="entry"
                                                                     Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                                     BorderThickness="0" Background="Transparent"
                                                                     Padding="0" VerticalContentAlignment="Center"
                                                                     Foreground="{DynamicResource OnSurface}" CaretBrush="{DynamicResource OnSurface}"
                                                                     m3:InputFilter.Kind="{Binding Column.Kind}" />
                                                            <TextBlock x:Name="shown" Text="{Binding Text}"
                                                                       VerticalAlignment="Center" Visibility="Collapsed"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource OnSurfaceVariant}" />
                                                        </Grid>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsWritable}" Value="False">
                                                            <Setter TargetName="entry" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="shown" Property="Visibility" Value="Visible" />
                                                            <Setter TargetName="cell" Property="Background" Value="Transparent" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DockPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Included}" Value="False">
                                            <Setter TargetName="row" Property="Opacity" Value="0.45" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button HorizontalAlignment="Left" Margin="0,2,0,0" Style="{StaticResource TextButton}"
                                Command="{x:Static m3:DataTableEditor.AddRowCommand}"
                                Visibility="{Binding CanAddRows, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Visible}}">
                            <StackPanel Orientation="Horizontal">
                                <m3:PathIcon Glyph="Plus" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock x:Name="addText" Text="{TemplateBinding AddText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="AddText" Value="{x:Null}">
                            <Setter TargetName="addText" Property="Text" Value="{m3:Text Add}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="M3ComboItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Padding" Value="11,8" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="m3:Metrics.CornerRadius" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid x:Name="b" Background="Transparent">
                        <Border x:Name="sel" Background="{DynamicResource SecondaryContainer}" Opacity="0"
                                CornerRadius="{m3:FitCornerRadius}" />
                        <Border x:Name="st" Background="{TemplateBinding Foreground}" Opacity="0"
                                CornerRadius="{m3:FitCornerRadius}" />
                        <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="st" Storyboard.TargetProperty="Opacity" To="0.08" Duration="0:0:0.13" EasingFunction="{StaticResource M3StandardDecelerate}" /></Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="st" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.13" EasingFunction="{StaticResource M3StandardAccelerate}" /></Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainer}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="sel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" EasingFunction="{StaticResource M3StandardDecelerate}" /></Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="sel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" EasingFunction="{StaticResource M3StandardAccelerate}" /></Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="M3Combo" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
        <Setter Property="Height" Value="{DynamicResource ControlHeight}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,0,8,0" />
        <Setter Property="m3:Metrics.CornerRadius" Value="{DynamicResource RadiusXs}" />
        <Setter Property="m3:Metrics.GlyphSize" Value="20" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource M3FocusRingXs}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource M3ComboItem}" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="box" Background="{DynamicResource SurfaceContainerHighest}" CornerRadius="{m3:FitCornerRadius}"
                                BorderBrush="{DynamicResource OutlineVariant}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Border x:Name="st" Background="{DynamicResource OnSurface}" Opacity="0" CornerRadius="{m3:FitCornerRadius}" />
                                <DockPanel Margin="{TemplateBinding Padding}">
                                    <m3:PathIcon DockPanel.Dock="Right" Glyph="ChevronDown" Width="{TemplateBinding m3:Metrics.GlyphSize}"
                                                 Height="{TemplateBinding m3:Metrics.GlyphSize}" VerticalAlignment="Center"
                                                 Foreground="{DynamicResource OnSurfaceVariant}"
                                                 m3:Chevron.IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <Grid VerticalAlignment="Center">
                                        <TextBlock x:Name="hint" Text="{Binding Path=(m3:Placeholder.Text), RelativeSource={RelativeSource TemplatedParent}}"
                                                   Foreground="{DynamicResource OnSurfaceMuted}" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                          TextElement.Foreground="{TemplateBinding Foreground}" IsHitTestVisible="False" />
                                    </Grid>
                                </DockPanel>
                            </Grid>
                        </Border>
                        <ToggleButton Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <m3:AnimatedPopup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                                          m3:CenterPopup.IsEnabled="True" AllowsTransparency="True" Focusable="False" StaysOpen="False"
                                          PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                            <m3:PopupCard Margin="10,0,10,10" Padding="0,4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" m3:Metrics.CornerRadius="{Binding Path=(m3:Metrics.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" Focusable="False"
                                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </m3:PopupCard>
                        </m3:AnimatedPopup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SelectedItem" Value="{x:Null}">
                            <Setter TargetName="hint" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="st" Property="Opacity" Value="0.08" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Primary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="NavigationItemGlyph" TargetType="ContentControl">
        <Grid Width="{Binding Path=(m3:Metrics.GlyphSize), RelativeSource={RelativeSource AncestorType={x:Type m3:NavigationItem}}}"
              Height="{Binding Path=(m3:Metrics.GlyphSize), RelativeSource={RelativeSource AncestorType={x:Type m3:NavigationItem}}}">
            <m3:PathIcon>
                <m3:PathIcon.Glyph>
                    <MultiBinding>
                        <MultiBinding.Converter><m3:IconToggleGlyphConverter /></MultiBinding.Converter>
                        <Binding Path="IsSelected" RelativeSource="{RelativeSource AncestorType={x:Type m3:NavigationItem}}" />
                        <Binding Path="Glyph" RelativeSource="{RelativeSource AncestorType={x:Type m3:NavigationItem}}" />
                        <Binding Path="SelectedGlyph" RelativeSource="{RelativeSource AncestorType={x:Type m3:NavigationItem}}" />
                    </MultiBinding>
                </m3:PathIcon.Glyph>
            </m3:PathIcon>
            <m3:Badge x:Name="badge" Style="{DynamicResource NavigationBadge}" HorizontalAlignment="Right" VerticalAlignment="Top"
                      Count="{Binding BadgeCount, RelativeSource={RelativeSource AncestorType={x:Type m3:NavigationItem}}}"
                      IsDot="{Binding IsBadgeDot, RelativeSource={RelativeSource AncestorType={x:Type m3:NavigationItem}}}"
                      Tone="{Binding BadgeTone, RelativeSource={RelativeSource AncestorType={x:Type m3:NavigationItem}}}" />
            <m3:PathIcon x:Name="busy" Glyph="Loading" Width="12" Height="12" Visibility="Collapsed" m3:Busy.SpinWhileVisible="True"
                         Foreground="{DynamicResource Primary}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-8,0" />
        </Grid>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsBusy, RelativeSource={RelativeSource AncestorType={x:Type m3:NavigationItem}}}" Value="True">
                <Setter TargetName="badge" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="busy" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type m3:NavigationItem}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="m3:Metrics.GlyphSize" Value="24" />
        <Setter Property="m3:Metrics.CornerRadius" Value="16" />
        <Setter Property="m3:Metrics.IndicatorSize" Value="56,32" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource M3FocusRing}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="0,4,0,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type m3:NavigationItem}">
                    <StackPanel Background="Transparent" Margin="{TemplateBinding Padding}">
                        <Grid HorizontalAlignment="Center"
                              Width="{Binding Path=(m3:Metrics.IndicatorSize).Width, RelativeSource={RelativeSource TemplatedParent}}"
                              Height="{Binding Path=(m3:Metrics.IndicatorSize).Height, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border x:Name="pill" CornerRadius="{m3:FitCornerRadius}" Background="Transparent" />
                            <Border x:Name="state" CornerRadius="{m3:FitCornerRadius}" Background="{DynamicResource OnSurface}" Opacity="0" />
                            <ContentControl x:Name="glyph" Foreground="{DynamicResource OnSurfaceVariant}" Template="{StaticResource NavigationItemGlyph}" Focusable="False" IsTabStop="False"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock x:Name="label" Text="{TemplateBinding Content}" FontSize="{TemplateBinding FontSize}" Margin="0,4,0,0" HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource OnSurfaceVariant}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="state" Property="Opacity" Value="0.08" />
                            <Setter TargetName="label" Property="Foreground" Value="{DynamicResource OnSurface}" />
                            <Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource OnSurface}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="pill" Property="Background" Value="{DynamicResource SecondaryContainer}" />
