        <Setter Property="m3:Metrics.CornerRadius" Value="4,4,0,0" />
        <Setter Property="m3:Metrics.GlyphSize" Value="20" />
        <Setter Property="m3:Metrics.GlyphMargin" Value="-4,0,12,0" />
        <Setter Property="FieldHeight" Value="{DynamicResource FieldHeight}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type m3:TextField}">
                    <StackPanel>
                        <Grid x:Name="field" Height="{TemplateBinding FieldHeight}">
                            <Border x:Name="fill" CornerRadius="{m3:FitCornerRadius}" Background="{DynamicResource SurfaceContainerHighest}" />
                            <Border x:Name="st" CornerRadius="{m3:FitCornerRadius}" Background="{DynamicResource OnSurface}" Opacity="0" />
                            <Border x:Name="indicator" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource OnSurfaceVariant}" />
                            <m3:NotchedOutline x:Name="PART_Outline" Stroke="{DynamicResource Outline}" StrokeThickness="1" Visibility="Collapsed"
                                               Radius="{Binding Path=(m3:Metrics.CornerRadius).TopLeft, RelativeSource={RelativeSource TemplatedParent}}" />
                            <DockPanel x:Name="content" Margin="{TemplateBinding Padding}">
                                <m3:PathIcon x:Name="leadIcon" DockPanel.Dock="Left" Glyph="{TemplateBinding LeadingGlyph}" Width="{TemplateBinding m3:Metrics.GlyphSize}"
                                             Height="{TemplateBinding m3:Metrics.GlyphSize}" Margin="{TemplateBinding m3:Metrics.GlyphMargin}" VerticalAlignment="Center" Foreground="{DynamicResource OnSurfaceVariant}" />
                                <Button x:Name="PART_Trailing" DockPanel.Dock="Right" Style="{StaticResource RowIconButton}" Width="32" Height="32" Margin="8,0,-8,0">
                                    <m3:PathIcon Glyph="{TemplateBinding TrailingGlyph}" Width="{Binding Path=(m3:Metrics.GlyphSize), RelativeSource={RelativeSource AncestorType={x:Type m3:TextField}}}"
                                                 Height="{Binding Path=(m3:Metrics.GlyphSize), RelativeSource={RelativeSource AncestorType={x:Type m3:TextField}}}" />
                                </Button>
                                <Grid>
                                    <TextBox x:Name="PART_Editor" VerticalAlignment="Center" BorderThickness="0" Background="Transparent" Padding="0"
                                             FontSize="{TemplateBinding FontSize}" Margin="-2,16,0,0"
                                             Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{TemplateBinding IsReadOnly}" MaxLength="{TemplateBinding MaxLength}" />
                                    <PasswordBox x:Name="PART_Password" VerticalAlignment="Center" BorderThickness="0" Background="Transparent" Padding="0"
                                                 FontSize="{TemplateBinding FontSize}" Margin="-2,16,0,0" Visibility="Collapsed" MaxLength="{TemplateBinding MaxLength}"
                                                 Foreground="{DynamicResource OnSurface}" CaretBrush="{DynamicResource OnSurface}" FocusVisualStyle="{x:Null}">
                                        <PasswordBox.Template>
                                            <ControlTemplate TargetType="PasswordBox">
                                                <ScrollViewer x:Name="PART_ContentHost" />
                                            </ControlTemplate>
                                        </PasswordBox.Template>
                                    </PasswordBox>
                                </Grid>
                            </DockPanel>
                            <Canvas x:Name="labelHost" IsHitTestVisible="False" ClipToBounds="False">
                                <TextBlock x:Name="PART_Label" Text="{TemplateBinding Label}" FontSize="{TemplateBinding FontSize}"
                                           Foreground="{DynamicResource OnSurfaceVariant}"
                                           Canvas.Left="{Binding ActualWidth, ElementName=leadSpace}" Canvas.Top="17" />
                            </Canvas>
                            <Border x:Name="leadSpace" Width="16" HorizontalAlignment="Left" Visibility="Hidden" />
                        </Grid>
                        <TextBlock x:Name="PART_Line" Text="{TemplateBinding LineText}" FontSize="12" Margin="16,4,16,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource OnSurfaceVariant}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="LeadingGlyph" Value="{x:Null}">
                            <Setter TargetName="leadIcon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Visibility, ElementName=leadIcon}" Value="Visible">
                            <Setter TargetName="leadSpace" Property="Width" Value="44" />
                        </DataTrigger>
                        <Trigger Property="TrailingGlyph" Value="{x:Null}">
                            <Setter TargetName="PART_Trailing" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Label" Value="{x:Null}">
                            <Setter TargetName="PART_Editor" Property="Margin" Value="-2,0,0,0" />
                            <Setter TargetName="PART_Password" Property="Margin" Value="-2,0,0,0" />
                        </Trigger>
                        <Trigger Property="LineText" Value="{x:Null}">
                            <Setter TargetName="PART_Line" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsPassword" Value="True">
                            <Setter TargetName="PART_Editor" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_Password" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Variant" Value="Outlined">
                            <Setter TargetName="fill" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="st" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_Outline" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_Editor" Property="Margin" Value="-2,0,0,0" />
                            <Setter TargetName="PART_Password" Property="Margin" Value="-2,0,0,0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="st" Property="Opacity" Value="0.08" />
                            <Setter TargetName="indicator" Property="Background" Value="{DynamicResource OnSurface}" />
                            <Setter TargetName="PART_Outline" Property="Stroke" Value="{DynamicResource OnSurface}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="indicator" Property="Height" Value="2" />
                            <Setter TargetName="indicator" Property="Background" Value="{DynamicResource Primary}" />
                            <Setter TargetName="PART_Outline" Property="StrokeThickness" Value="2" />
                            <Setter TargetName="PART_Outline" Property="Stroke" Value="{DynamicResource Primary}" />
                            <Setter TargetName="PART_Label" Property="Foreground" Value="{DynamicResource Primary}" />
                        </Trigger>
                        <Trigger Property="IsError" Value="True">
                            <Setter TargetName="indicator" Property="Background" Value="{DynamicResource Error}" />
                            <Setter TargetName="PART_Outline" Property="Stroke" Value="{DynamicResource Error}" />
                            <Setter TargetName="PART_Label" Property="Foreground" Value="{DynamicResource Error}" />
                            <Setter TargetName="PART_Line" Property="Foreground" Value="{DynamicResource Error}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type m3:StepChecklist}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="m3:Metrics.IndicatorSize" Value="18,18" />
        <Setter Property="m3:Metrics.GlyphMargin" Value="0,0,12,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type m3:StepChecklist}">
                    <StackPanel x:Name="PART_Rows" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
