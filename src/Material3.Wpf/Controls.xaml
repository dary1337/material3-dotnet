    <Style x:Key="M3RoundCheckBox" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource M3FocusRingRound}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="m3:Metrics.IndicatorSize" Value="22,22" />
        <Setter Property="m3:Metrics.GlyphSize" Value="15" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="layer" Fill="{DynamicResource OnSurface}" Opacity="0" />
                        <Ellipse x:Name="ring" Width="{Binding Path=(m3:Metrics.IndicatorSize).Width, RelativeSource={RelativeSource TemplatedParent}}" Height="{Binding Path=(m3:Metrics.IndicatorSize).Height, RelativeSource={RelativeSource TemplatedParent}}" StrokeThickness="2" Stroke="{DynamicResource Outline}" />
                        <Grid x:Name="fill" Width="{Binding Path=(m3:Metrics.IndicatorSize).Width, RelativeSource={RelativeSource TemplatedParent}}" Height="{Binding Path=(m3:Metrics.IndicatorSize).Height, RelativeSource={RelativeSource TemplatedParent}}" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><ScaleTransform x:Name="scale" ScaleX="0" ScaleY="0" /></Grid.RenderTransform>
                            <Ellipse Fill="{DynamicResource Primary}" />
                            <m3:PathIcon Glyph="Check" Width="{TemplateBinding m3:Metrics.GlyphSize}" Height="{TemplateBinding m3:Metrics.GlyphSize}" Foreground="{DynamicResource OnPrimary}" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="layer" Property="Opacity" Value="0.08" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="layer" Property="Opacity" Value="0.12" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="0" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type m3:OptionCard}">
        <Style.Triggers>
            <Trigger Property="Indicator" Value="Check"><Setter Property="m3:Metrics.IndicatorSize" Value="22,22" /></Trigger>
        </Style.Triggers>
        <Setter Property="FocusVisualStyle" Value="{StaticResource M3FocusRingLg}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="m3:Metrics.CornerRadius" Value="16" />
        <Setter Property="m3:Metrics.GlyphMargin" Value="0,0,12,0" />
        <Setter Property="m3:Metrics.IndicatorSize" Value="20,20" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type m3:OptionCard}">
                    <Grid>
                        <Border x:Name="surface" CornerRadius="{m3:FitCornerRadius}" BorderThickness="{TemplateBinding BorderThickness}" Background="{DynamicResource SurfaceContainer}"
                                BorderBrush="{DynamicResource OutlineVariant}" />
                        <Border x:Name="PART_Selected" CornerRadius="{m3:FitCornerRadius}" BorderThickness="{TemplateBinding BorderThickness}" Opacity="0"
                                Background="{DynamicResource SurfaceContainerHigh}" BorderBrush="{DynamicResource Primary}" />
                        <Border x:Name="hover" CornerRadius="{m3:FitCornerRadius}" Background="{DynamicResource OnSurface}" Opacity="0" />
                        <Border BorderThickness="{TemplateBinding BorderThickness}">
                            <DockPanel Margin="{TemplateBinding Padding}">
                                <ContentPresenter x:Name="leading" DockPanel.Dock="Left" Content="{TemplateBinding Leading}" Margin="{TemplateBinding m3:Metrics.GlyphMargin}"
                                                  VerticalAlignment="Center" TextElement.Foreground="{DynamicResource OnSurfaceVariant}" />
                                <Viewbox x:Name="radio" DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Center"
                                         Width="{Binding Path=(m3:Metrics.IndicatorSize).Width, RelativeSource={RelativeSource TemplatedParent}}"
                                         Height="{Binding Path=(m3:Metrics.IndicatorSize).Height, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Grid Width="20" Height="20">
                                        <Ellipse x:Name="radioRing" StrokeThickness="2" Stroke="{DynamicResource Outline}" />
                                        <Ellipse x:Name="PART_Mark" Width="10" Height="10" Fill="{DynamicResource Primary}" />
                                    </Grid>
                                </Viewbox>
                                <Grid x:Name="check" DockPanel.Dock="Right" Width="40" Height="40" Margin="2,0,-8,0" VerticalAlignment="Center"
                                      Visibility="Collapsed">
                                    <Ellipse x:Name="checkLayer" Fill="{DynamicResource OnSurface}" Opacity="0" />
                                    <Viewbox Width="{Binding Path=(m3:Metrics.IndicatorSize).Width, RelativeSource={RelativeSource TemplatedParent}}"
                                             Height="{Binding Path=(m3:Metrics.IndicatorSize).Height, RelativeSource={RelativeSource TemplatedParent}}">
                                        <Grid Width="22" Height="22">
                                            <Ellipse StrokeThickness="2" Stroke="{DynamicResource Outline}" />
                                            <Grid x:Name="PART_CheckMark">
                                                <Ellipse Fill="{DynamicResource Primary}" />
                                                <m3:PathIcon Glyph="Check" Width="15" Height="15" Foreground="{DynamicResource OnPrimary}" />
                                            </Grid>
                                        </Grid>
                                    </Viewbox>
                                </Grid>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </DockPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Leading" Value="{x:Null}">
                            <Setter TargetName="leading" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Tone" Value="Warning">
                            <Setter TargetName="surface" Property="BorderBrush" Value="{DynamicResource Warning}" />
                        </Trigger>
                        <Trigger Property="Tone" Value="Error">
                            <Setter TargetName="surface" Property="BorderBrush" Value="{DynamicResource Error}" />
                        </Trigger>
                        <Trigger Property="Indicator" Value="Check">
                            <Setter TargetName="radio" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Indicator" Value="None">
                            <Setter TargetName="radio" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="hover" Property="Opacity" Value="{Binding HoverOpacity, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger SourceName="check" Property="IsMouseOver" Value="True">
                            <Setter TargetName="checkLayer" Property="Opacity" Value="0.08" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="radioRing" Property="Stroke" Value="{DynamicResource Primary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
