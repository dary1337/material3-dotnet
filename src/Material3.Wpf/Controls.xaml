                                    <VisualTransition GeneratedDuration="0:0:0.13"><VisualTransition.GeneratedEasingFunction><StaticResource ResourceKey="M3StandardDecelerate" /></VisualTransition.GeneratedEasingFunction></VisualTransition>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="MouseOver"><Storyboard><DoubleAnimation Storyboard.TargetName="state" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /></Storyboard></VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid>
                            <Border x:Name="state" Background="{DynamicResource SurfaceContainerHighest}" CornerRadius="{m3:FitCornerRadius}" Opacity="0" />
                            <m3:PathIcon x:Name="icon" Width="{TemplateBinding m3:Metrics.GlyphSize}" Height="{TemplateBinding m3:Metrics.GlyphSize}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource OnSurfaceVariant}">
                                <m3:PathIcon.Glyph>
                                    <MultiBinding>
                                        <MultiBinding.Converter><m3:IconToggleGlyphConverter /></MultiBinding.Converter>
                                        <Binding Path="IsChecked" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="(m3:IconToggle.Glyph)" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="(m3:IconToggle.CheckedGlyph)" RelativeSource="{RelativeSource TemplatedParent}" />
                                    </MultiBinding>
                                </m3:PathIcon.Glyph>
                            </m3:PathIcon>
                            <m3:PathIcon x:Name="spin" Glyph="Loading" Width="{TemplateBinding m3:Metrics.GlyphSize}" Height="{TemplateBinding m3:Metrics.GlyphSize}" Visibility="Collapsed"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Primary}"
                                       m3:Busy.SpinWhileVisible="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="m3:IconToggle.CheckedGlyph" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="icon" Property="Foreground" Value="{DynamicResource Primary}" />
                            <Setter TargetName="state" Property="Opacity" Value="1" />
                        </MultiTrigger>
                        <Trigger Property="m3:Busy.IsBusy" Value="True">
                            <Setter TargetName="icon" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="spin" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="icon" Property="Foreground" Value="{DynamicResource OnSurfaceMuted}" />
                            <Setter Property="Opacity" Value="0.38" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="M3Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource M3FocusRing}" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
        <Setter Property="Padding" Value="0,0,14,0" />
        <Setter Property="m3:Metrics.IndicatorSize" Value="52,32" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <DockPanel Background="Transparent" LastChildFill="True">
                        <Viewbox VerticalAlignment="Center" DockPanel.Dock="Right"
                                 Width="{Binding Path=(m3:Metrics.IndicatorSize).Width, RelativeSource={RelativeSource TemplatedParent}}"
                                 Height="{Binding Path=(m3:Metrics.IndicatorSize).Height, RelativeSource={RelativeSource TemplatedParent}}">
                        <Grid Width="46" Height="28">
                            <Border x:Name="trackOff" CornerRadius="14" BorderThickness="2"
                                    BorderBrush="{DynamicResource OnSurfaceVariant}" Background="{DynamicResource SurfaceContainerHighest}" />
                            <Border x:Name="trackOn" CornerRadius="14" Background="{DynamicResource Primary}" Opacity="0" />
                            <Grid x:Name="thumbGroup" Width="28" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Grid.RenderTransform><TranslateTransform x:Name="slide" /></Grid.RenderTransform>
                                <Ellipse x:Name="state" Width="28" Height="28" Fill="{DynamicResource OnSurface}" Opacity="0" />
                                <Ellipse x:Name="thumbOff" Width="16" Height="16" Fill="{DynamicResource OnSurfaceVariant}" />
                                <Ellipse x:Name="thumbOn" Width="20" Height="20" Fill="{DynamicResource OnPrimary}" Opacity="0" />
                            </Grid>
                        </Grid>
                        </Viewbox>
                        <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="slide" Storyboard.TargetProperty="X" To="18" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="trackOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="thumbOff" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="thumbOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="slide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="trackOn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="thumbOff" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="thumbOn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="state" Storyboard.TargetProperty="Opacity" To="0.10" Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="state" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="M3Radio" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource M3FocusRing}" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
        <Setter Property="Padding" Value="10,0,0,0" />
        <Setter Property="m3:Metrics.IndicatorSize" Value="20,20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Viewbox VerticalAlignment="Center"
                                 Width="{Binding Path=(m3:Metrics.IndicatorSize).Width, RelativeSource={RelativeSource TemplatedParent}}"
                                 Height="{Binding Path=(m3:Metrics.IndicatorSize).Height, RelativeSource={RelativeSource TemplatedParent}}">
                        <Grid Width="20" Height="20">
                            <Ellipse x:Name="ring" Width="20" Height="20" StrokeThickness="2"
                                     Stroke="{DynamicResource OnSurfaceVariant}" Fill="Transparent" />
                            <Ellipse x:Name="dot" Width="10" Height="10" Fill="{DynamicResource Primary}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><ScaleTransform x:Name="dotScale" ScaleX="0" ScaleY="0" /></Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        </Viewbox>
                        <ContentPresenter x:Name="label" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource Primary}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="dotScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="dotScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="dotScale" Storyboard.TargetProperty="ScaleX" To="0" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="dotScale" Storyboard.TargetProperty="ScaleY" To="0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="label" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

