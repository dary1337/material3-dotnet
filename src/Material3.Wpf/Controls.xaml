    <Style TargetType="{x:Type m3:TitleBar}">
        <Setter Property="Height" Value="40" />
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightMedium}" />
        <Setter Property="Padding" Value="12,0,6,0" />
        <Setter Property="m3:Metrics.GlyphSize" Value="20" />
        <Setter Property="m3:Metrics.GlyphMargin" Value="0,0,8,0" />
        <Setter Property="m3:Metrics.IndicatorSize" Value="44,32" />
        <Setter Property="m3:Metrics.CornerRadius" Value="16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type m3:TitleBar}">
                    <ControlTemplate.Resources>
                        <Style x:Key="CaptionButton" TargetType="Button">
                            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
                            <Setter Property="Width" Value="{Binding Path=(m3:Metrics.IndicatorSize).Width, RelativeSource={RelativeSource AncestorType={x:Type m3:TitleBar}}}" />
                            <Setter Property="Height" Value="{Binding Path=(m3:Metrics.IndicatorSize).Height, RelativeSource={RelativeSource AncestorType={x:Type m3:TitleBar}}}" />
                            <Setter Property="Margin" Value="4,0,0,0" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}" />
                            <Setter Property="Tag" Value="{DynamicResource OnSurfaceVariant}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Grid Background="Transparent">
                                            <Border x:Name="state" Background="{TemplateBinding Tag}" Opacity="0"
                                                    CornerRadius="{Binding Path=(m3:Metrics.CornerRadius), RelativeSource={RelativeSource AncestorType={x:Type m3:TitleBar}}}" />
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="state" Property="Opacity" Value="0.08" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="state" Property="Opacity" Value="0.12" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ControlTemplate.Resources>
                    <Grid Background="{TemplateBinding Background}" Margin="{TemplateBinding Padding}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image x:Name="icon" Source="{TemplateBinding Icon}" Width="{TemplateBinding m3:Metrics.GlyphSize}"
                                   Height="{TemplateBinding m3:Metrics.GlyphSize}" Margin="{TemplateBinding m3:Metrics.GlyphMargin}" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock x:Name="title" Text="{TemplateBinding Title}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource OnSurface}" />
                        </StackPanel>
                        <ContentPresenter Grid.Column="1" Content="{TemplateBinding Header}" VerticalAlignment="Center" Margin="16,0,0,0"
                                          TextElement.FontWeight="Normal" WindowChrome.IsHitTestVisibleInChrome="True" />
                        <ContentPresenter Grid.Column="3" Content="{TemplateBinding Actions}" VerticalAlignment="Center" Margin="0,0,6,0"
                                          TextElement.FontWeight="Normal" WindowChrome.IsHitTestVisibleInChrome="True" />
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"
                                    UseLayoutRounding="True" SnapsToDevicePixels="True">
                            <Button x:Name="PART_Minimize" Style="{StaticResource CaptionButton}" AutomationProperties.Name="{m3:Text Minimize}">
                                <Rectangle Width="11" Height="1" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                            <Button x:Name="PART_Maximize" Style="{StaticResource CaptionButton}" AutomationProperties.Name="{m3:Text Maximize}">
                                <Grid>
                                    <Rectangle x:Name="maxGlyph" Width="10" Height="10" StrokeThickness="1"
                                               Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <Grid x:Name="restoreGlyph" Width="11" Height="11" Visibility="Collapsed">
                                        <Rectangle Width="8" Height="8" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                   Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <Rectangle Width="8" Height="8" StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                   Fill="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type m3:TitleBar}}}"
                                                   Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Grid>
                                </Grid>
                            </Button>
                            <Button x:Name="PART_Close" Style="{StaticResource CaptionButton}" Tag="{DynamicResource Error}" AutomationProperties.Name="{m3:Text Close}">
                                <Path Data="M0,0 L10,10 M0,10 L10,0" StrokeThickness="1"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Title" Value="{x:Null}">
                            <Setter TargetName="title" Property="Text" Value="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </Trigger>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="icon" Property="Source" Value="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </Trigger>
                        <Trigger SourceName="icon" Property="Source" Value="{x:Null}">
                            <Setter TargetName="icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger SourceName="PART_Close" Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Close" Property="Foreground" Value="{DynamicResource Error}" />
                        </Trigger>
                        <Trigger Property="IsMaximized" Value="True">
                            <Setter TargetName="maxGlyph" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="restoreGlyph" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_Maximize" Property="AutomationProperties.Name" Value="{m3:Text Restore}" />
                        </Trigger>
                        <Trigger Property="ShowMinimize" Value="False">
                            <Setter TargetName="PART_Minimize" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ShowMaximize" Value="False">
                            <Setter TargetName="PART_Maximize" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ShowClose" Value="False">
                            <Setter TargetName="PART_Close" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type m3:Badge}">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightMedium}" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="Background" Value="{DynamicResource Error}" />
        <Setter Property="Foreground" Value="{DynamicResource OnError}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Surface}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="m3:Metrics.CornerRadius" Value="8" />
        <Setter Property="m3:Metrics.IndicatorSize" Value="6,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type m3:Badge}">
                    <Grid x:Name="PART_Root">
                        <Border x:Name="pill" MinWidth="{TemplateBinding PillHeight}" Height="{TemplateBinding PillHeight}" CornerRadius="{m3:FitCornerRadius}"
                                Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <TextBlock x:Name="label" Text="{TemplateBinding Text}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <Ellipse x:Name="dot" Fill="{TemplateBinding Background}" Visibility="Collapsed"
                                 Stroke="{TemplateBinding BorderBrush}" StrokeThickness="{Binding BorderThickness.Left, RelativeSource={RelativeSource TemplatedParent}}"
                                 Width="{Binding Path=(m3:Metrics.IndicatorSize).Width, RelativeSource={RelativeSource TemplatedParent}}"
                                 Height="{Binding Path=(m3:Metrics.IndicatorSize).Height, RelativeSource={RelativeSource TemplatedParent}}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="pill" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsDot" Value="True">
                            <Setter TargetName="pill" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Tone" Value="Neutral">
                <Setter Property="Background" Value="{DynamicResource OnSurfaceVariant}" />
                <Setter Property="Foreground" Value="{DynamicResource SurfaceContainerHighest}" />
            </Trigger>
            <Trigger Property="Tone" Value="Accent">
                <Setter Property="Background" Value="{DynamicResource Primary}" />
                <Setter Property="Foreground" Value="{DynamicResource OnPrimary}" />
            </Trigger>
            <Trigger Property="Tone" Value="Success">
                <Setter Property="Background" Value="{DynamicResource Success}" />
                <Setter Property="Foreground" Value="{DynamicResource OnSuccess}" />
            </Trigger>
            <Trigger Property="Tone" Value="Warning">
                <Setter Property="Background" Value="{DynamicResource Warning}" />
                <Setter Property="Foreground" Value="{DynamicResource OnWarning}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NavigationBadge" TargetType="{x:Type m3:Badge}" BasedOn="{StaticResource {x:Type m3:Badge}}">
        <Setter Property="Margin" Value="0,-6,-10,0" />
        <Style.Triggers>
            <Trigger Property="IsDot" Value="True">
                <Setter Property="Margin" Value="0,-1,-3,0" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type m3:SearchBar}">
        <Setter Property="Height" Value="{DynamicResource ControlHeight}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="16,0,8,0" />
        <Setter Property="m3:Metrics.CornerRadius" Value="{DynamicResource RadiusPill}" />
        <Setter Property="m3:Metrics.GlyphSize" Value="20" />
        <Setter Property="m3:Metrics.GlyphMargin" Value="0,0,12,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type m3:SearchBar}">
                    <Border x:Name="bg" CornerRadius="{m3:FitCornerRadius}" Background="{DynamicResource SurfaceContainerHigh}">
                        <Grid>
                            <Border x:Name="st" CornerRadius="{m3:FitCornerRadius}" Background="{DynamicResource OnSurface}" Opacity="0" />
                            <DockPanel Margin="{TemplateBinding Padding}">
                                <m3:PathIcon DockPanel.Dock="Left" Glyph="Magnify" Width="{TemplateBinding m3:Metrics.GlyphSize}" Height="{TemplateBinding m3:Metrics.GlyphSize}"
                                             Margin="{TemplateBinding m3:Metrics.GlyphMargin}"
                                             VerticalAlignment="Center" Foreground="{DynamicResource OnSurfaceVariant}" />
                                <Button x:Name="PART_Clear" DockPanel.Dock="Right" Style="{StaticResource RowIconButton}" Width="32" Height="32"
                                        m3:Tip.Text="{m3:Text Clear}">
                                    <m3:PathIcon Glyph="Close" Width="18" Height="18" />
                                </Button>
                                <TextBox x:Name="PART_Editor" VerticalAlignment="Center" BorderThickness="0" Background="Transparent" Padding="0"
                                         FontSize="{TemplateBinding FontSize}" Text="{Binding Query, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                                         m3:Placeholder.Text="{TemplateBinding Placeholder}" />
                            </DockPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="st" Property="Opacity" Value="0.08" />
                        </Trigger>
                        <Trigger Property="Placeholder" Value="{x:Null}">
                            <Setter TargetName="PART_Editor" Property="m3:Placeholder.Text" Value="{m3:Text Search}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Text.Length, ElementName=PART_Editor}" Value="0">
                            <Setter TargetName="PART_Clear" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type m3:Tabs}">
        <Style.Resources>
            <Style TargetType="TabItem">
                <Setter Property="Height" Value="48" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="MinWidth" Value="90" />
                <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="{DynamicResource FontWeightMedium}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource M3FocusRing}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Grid Background="Transparent">
                                <Border x:Name="st" Background="{DynamicResource OnSurface}" Opacity="0" />
                                <ContentPresenter x:Name="label" ContentSource="Header" Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource ButtonLabel}" />
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="st" Property="Opacity" Value="0.08" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
                                </Trigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                        <Condition Binding="{Binding Variant, RelativeSource={RelativeSource AncestorType={x:Type m3:Tabs}}}" Value="Primary" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Foreground" Value="{DynamicResource Primary}" />
                                </MultiDataTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.38" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Style.Resources>
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="m3:Metrics.IndicatorSize" Value="0,3" />
        <Setter Property="m3:Metrics.CornerRadius" Value="3,3,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type m3:Tabs}">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Orientation="Horizontal" IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                            <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource OutlineVariant}" IsHitTestVisible="False" />
                            <Canvas x:Name="track" VerticalAlignment="Bottom" IsHitTestVisible="False"
                                    Height="{Binding Path=(m3:Metrics.IndicatorSize).Height, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border x:Name="PART_Indicator" CornerRadius="{m3:FitCornerRadius}" Background="{DynamicResource Primary}"
                                        Height="{Binding Path=(m3:Metrics.IndicatorSize).Height, RelativeSource={RelativeSource TemplatedParent}}" Visibility="Collapsed" />
                            </Canvas>
                        </Grid>
                        <ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"
                                          Margin="{TemplateBinding Padding}" KeyboardNavigation.TabIndex="2" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Variant" Value="Secondary">
                <Setter Property="m3:Metrics.IndicatorSize" Value="0,2" />
                <Setter Property="m3:Metrics.CornerRadius" Value="0" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type m3:TextField}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
