<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net472;net8.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Material3.Wpf</RootNamespace>
    <AssemblyName>Material3.Wpf</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <PackageId>Material3.Wpf</PackageId>
    <Version>0.11.0</Version>
    <Authors>dary1337</Authors>
    <Description>Material 3 (Material You) for WPF: a runtime ThemeManager that builds the M3 color-role scheme from one seed (HCT) and publishes it as live DynamicResource brushes, plus the M3 control set, dialogs and pickers, a title bar, elevation, motion and an icon-set-agnostic PathIcon. Built on Material3.Core.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/dary1337/material3-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dary1337/material3-dotnet</RepositoryUrl>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.10.0</PackageValidationBaselineVersion>
    <PackageTags>material3;material-you;material-design;wpf;theme;dark-mode;dynamic-color;hct</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\*.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Material3.Core\Material3.Core.csproj" />
    <None Include="..\..\docs\nuget\Wpf.md" Pack="true" PackagePath="\README.md" />
  </ItemGroup>

</Project>
